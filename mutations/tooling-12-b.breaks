find: !hunk.is_addition() && hunk.b_end - hunk.b_start >= hunk.a_end - hunk.a_start
replace: !hunk.is_addition()
caught-by:
    rebase::tests::an_addition_beside_lines_the_other_side_deleted_is_left

[break] rebase-an-addition-before-a-change
