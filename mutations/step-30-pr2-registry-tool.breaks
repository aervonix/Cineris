# --- A server's tool: what the model is shown, and its scheduling ----------------

[break] an-mcp-tool-runs-beside-others
rule: A server's tool is exclusive in its spec, whatever its annotations say.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::new
find: .concurrency(ConcurrencyClass::Exclusive);
replace: .concurrency(ConcurrencyClass::ReadOnly);
caught-by:
    cineris-mcp::it tool::the_spec_is_cleaned_asks_and_runs_alone_whatever_the_server_says

[break] an-mcp-tools-plan-runs-beside-others
rule: A server tool's plan is scheduled exclusive and has no effect of its own.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::plan
find: Ok(Plan::new(summary, args.clone()).with_concurrency(Concurrency::Exclusive))
replace: Ok(Plan::new(summary, args.clone()).with_concurrency(Concurrency::ReadOnly))
caught-by:
    cineris-mcp::it tool::a_call_is_planned_alone_with_the_tools_name_as_its_effect

[break] an-mcp-tool-allows-by-default
rule: A server's tool asks unless a rule allows it.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::new
find: .permission(RuleAction::Ask)
replace: .permission(RuleAction::Allow)
caught-by:
    cineris-mcp::it tool::the_spec_is_cleaned_asks_and_runs_alone_whatever_the_server_says

[break] a-description-is-shown-as-the-server-wrote-it
rule: A tool's title and description are made one line each, what acts unseen taken out, cut at 2 KiB.
file: crates/cineris-mcp/src/tool.rs
in: description_of
find: let one = |text: &str| one_line(text, MAX_DESCRIPTION_BYTES);
replace: let one = |text: &str| if MAX_DESCRIPTION_BYTES > 0 { text.to_owned() } else { one_line(text, 0) };
caught-by:
    cineris-mcp::it tool::the_spec_is_cleaned_asks_and_runs_alone_whatever_the_server_says

[break] a-schemas-strings-are-not-cleaned
rule: What acts unseen in every string of a server's schema is written as an escape.
file: crates/cineris-mcp/src/tool.rs
in: cleaned
find: Json::String(text) => Json::String(clean(text))
replace: Json::String(text) => Json::String(text.clone())
caught-by:
    cineris-mcp::it tool::the_spec_is_cleaned_asks_and_runs_alone_whatever_the_server_says

[break] a-title-is-not-the-first-line
rule: A tool's title, when given, is the first line of its description, made one line.
file: crates/cineris-mcp/src/tool.rs
in: description_of
find: (Some(title), Some(description)) => format!("{title}\n{description}")
replace: (Some(_), Some(description)) => description
caught-by:
    cineris-mcp::it tool::the_spec_is_cleaned_asks_and_runs_alone_whatever_the_server_says

# --- A server's tool: a call ------------------------------------------------------

[break] a-result-is-not-labelled
rule: A result begins with one line naming the server and the tool as the server's output.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::rendered
find: format!("{}\n{}", self.label(), parts.join("\n"))
replace: parts.join("\n")
caught-by:
    cineris-mcp::it tool::a_result_is_labelled_as_the_servers_and_each_block_has_its_form

[break] unseen-text-in-a-result-is-passed-on
rule: What acts unseen in a result's text, and is not a control character, is written as an escape.
file: crates/cineris-mcp/src/tool.rs
in: as_received
find: visible_keeping(text, &CONTROLS)
replace: if CONTROLS.is_empty() { visible_keeping(text, &CONTROLS) } else { Cow::Borrowed(text) }
caught-by:
    cineris-mcp::it tool::a_result_is_labelled_as_the_servers_and_each_block_has_its_form

[break] an-image-is-not-said-in-a-line
rule: An image is one line naming its type and size.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::rendered
find: format!("[an image, {}, {}: not shown]", line(mime), size(*bytes))
replace: format!("[an image, {}, {}: not shown]", line(mime), size(*bytes / 2))
caught-by:
    cineris-mcp::it tool::a_result_is_labelled_as_the_servers_and_each_block_has_its_form

[break] structured-is-given-twice
rule: A structured result a text block carries is not given again.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::rendered
find: if !carried {
replace: if true {
caught-by:
    cineris-mcp::it tool::a_structured_result_is_given_once

[break] structured-is-dropped
rule: A structured result no text block carries is given as compact JSON.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::rendered
find: if !carried {
replace: if false {
caught-by:
    cineris-mcp::it tool::a_structured_result_is_given_once

[break] a-servers-error-is-a-success
rule: A result the server marks as an error is an error result.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::run
find: Ok(output) if output.is_error => ToolResult::error(self.rendered(&output))
replace: Ok(output) if output.is_error => ToolResult::success(self.rendered(&output))
caught-by:
    cineris-mcp::it tool::errors_are_error_results_in_words

[break] a-clients-error-is-shown-unescaped
rule: A failed call is an error in words, a server's message in them escaped and cut.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::failed
find: cut(&visible_to_the_model(&other.to_string()), MAX_SHOWN)
replace: other.to_string()
caught-by:
    cineris-mcp::it tool::errors_are_error_results_in_words

[break] a-cancelled-call-is-an-error
rule: A cancelled call is interrupted, not failed.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::failed
find: ClientError::Cancelled => ToolResult::interrupted(format!("{what} was cancelled."))
replace: ClientError::Cancelled => ToolResult::error(format!("{what} was cancelled."))
caught-by:
    cineris-mcp::it tool::errors_are_error_results_in_words
    cineris-mcp::it tool::a_call_is_cancelled_with_its_token

[break] arguments-are-not-checked-before-sending
rule: Arguments are checked against the server's own schema before anything is sent.
file: crates/cineris-mcp/src/tool.rs
in: McpTool::run
find: cineris_tools::schema::validate(&self.schema, &arguments)
replace: cineris_tools::schema::validate(&Json::Bool(true), &arguments)
caught-by:
    cineris-mcp::it tool::arguments_that_do_not_fit_the_servers_schema_are_never_sent

# --- Registering a server's tools -------------------------------------------------

[break] a-source-is-described-by-nothing
rule: A server's source is described by its entry's own description.
file: crates/cineris-mcp/src/tool.rs
in: register
find: server.description.as_deref().unwrap_or_default()
replace: ""
packages: cineris-mcp, cineris-core
caught-by:
    cineris-mcp::it tool::a_server_registers_under_its_entry_with_its_holds
    cineris-core::it mcp_sources::a_servers_tools_change_the_index_by_notice_and_never_the_prefix

[break] a-held-tool-is-registered-unheld
rule: A held tool keeps its hold in the registry.
file: crates/cineris-mcp/src/tool.rs
in: register
find: let hold = tool.hold;
replace: let hold = None;
caught-by:
    cineris-mcp::it tool::a_server_registers_under_its_entry_with_its_holds

# --- Section 6 from the registry, in every build -----------------------------------

[break] a-servers-source-is-not-listed
rule: Section 6 lists the MCP servers' sources as the registry holds them when the loop asks.
file: crates/cineris-core/src/ext/prompt.rs
in: PromptParts::sections
find: .extend(self.registry.sources_of(SourceKind::Mcp));
replace: .extend(Vec::new());
caught-by:
    cineris-core ext::prompt::tests::a_servers_source_is_listed_as_the_registry_holds_it
    cineris-core::it mcp_sources::a_servers_tools_change_the_index_by_notice_and_never_the_prefix

[break] a-refused-extensions-text-is-kept-for-a-servers-name
rule: Section 7 holds the text of an extension the registry took as an extension's source: not one refused a name an MCP server holds.
file: crates/cineris-core/src/ext/found/pipeline.rs
find: .sources_of(cineris_tools::SourceKind::Extension)
replace: .sources()
caught-by:
    cineris-core::it extensions_prompt::an_extension_refused_a_name_a_server_holds_gives_no_text

[break] a-finding-settles-the-servers-sources
rule: The extensions' finding settles the extensions' sources alone; a server's is the registry's.
file: crates/cineris-core/src/ext/prompt.rs
in: PromptParts::settle
find: let sources = self.registry.sources_of(SourceKind::Extension);
replace: let sources = self.registry.sources();
caught-by:
    cineris-core ext::prompt::tests::a_servers_source_is_listed_as_the_registry_holds_it

# --- The round's cache of early results ---------------------------------------------

[break] a-kept-run-is-adopted-after-its-call-moved
rule: A run kept from a response sent again is not used for a call whose plan names other paths than the run's: the call runs again.
file: crates/cineris-agent/src/round.rs
in: Round::planned
find: cached.footprint.paths != footprint.paths
replace: false
caught-by:
    cineris-agent::it redecide::a_kept_read_is_not_used_for_a_call_planned_again_onto_another_path

# --- The check of a build without the MCP client --------------------------------------

[break] no-mcp-is-not-a-check
rule: `cargo xtask check` holds a build of the binary without the MCP client.
file: xtask/src/checks.rs
in: CHECK_STEPS
find: "no-mcp"
replace: "no-scripts"
caught-by:
    checks::tests::check_holds_a_build_of_the_binary_without_the_mcp_client

[break] the-build-without-mcp-keeps-it
rule: The check of a build without the MCP client turns the binary's `mcp` feature off and keeps the others.
file: xtask/src/checks.rs
in: NO_MCP
find: feature: "mcp"
replace: feature: "scripts"
caught-by:
    checks::tests::check_holds_a_build_of_the_binary_without_the_mcp_client
