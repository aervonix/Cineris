# ------------------------------------------- roles and the interrupt hand-off

[break] a-shell-says-restored-whatever-the-modes
rule: The shell says the terminal was put back only when its modes after the child are the ones before.
file: crates/cortex-testkit/src/role.rs
in: ModeShell::run
find: if before == after {
replace: if true {
packages: cortex-term
caught-by:
    system::sys_the_shell_says_when_the_terminal_was_not_put_back

[break] the-guard-does-not-drain-a-pending-interrupt
rule: An interrupt still pending as the guard ends is taken, not left to end the process.
file: crates/cortex-term/src/sys/unix.rs
in: restore_interrupts
find: let taken = libc::sigtimedwait(set.as_ptr(), std::ptr::null_mut(), &raw const now);
replace: let taken = 0;
caught-by:
    signals::sys_an_interrupt_pending_as_the_guard_ends_is_taken_by_it

[break] no-grace-after-the-guard
rule: For a second after a guard ends, the terminal's own handler passes an interrupt over.
file: crates/cortex-term/src/sys/unix.rs
in: guard_just_ended
find: ended != 0 && monotonic().saturating_sub(ended) < GUARD_GRACE_NANOS
replace: false
caught-by:
    signals::sys_an_interrupt_while_the_guard_lives_or_just_after_is_passed_over

[break] an-interrupt-while-the-guard-lives-ends-the-process
rule: While a guard lives, the terminal's own handler passes an interrupt over.
file: crates/cortex-term/src/sys/unix.rs
in: on_ending
find: (GUARDING.load(Ordering::SeqCst) || guard_just_ended())
replace: guard_just_ended()
caught-by:
    signals::sys_an_interrupt_while_the_guard_lives_or_just_after_is_passed_over

# --------------------------------------------- the estimate and the records

[break] a-crate-is-scaled-by-its-tiers-factor
rule: A crate the table knows is scaled by its own factor, not its tier's.
file: xtask/src/like_runner.rs
in: factor
find: .find(|(name, of, ..)| *name == krate && *of == tier)
replace: .find(|(name, of, ..)| *name == krate && *of == tier && false)
caught-by:
    like_runner::tests::a_crate_is_scaled_by_its_own_factor_and_an_unknown_one_by_its_tiers

[break] the-slow-runner-is-the-runner
rule: The estimate gives a slow runner's figure as well as the measured runner's.
file: xtask/src/like_runner.rs
in: estimate
find: Os::Windows => SLOW_RUNNER.1
replace: Os::Windows => 1.0
caught-by:
    like_runner::tests::a_crate_is_scaled_by_its_own_factor_and_an_unknown_one_by_its_tiers

[break] an-ab-is-the-mean-of-its-rounds
rule: An A/B's tables are of each test's median over the rounds.
file: xtask/src/records.rs
in: compare
find: let base = crate::ab::medians(&sides.base);
replace: let base = sides.base.concat();
caught-by:
    records::tests::an_ab_is_each_tiers_median_on_both_sides_with_the_change

[break] main-is-labelled-as-the-pr
rule: The records label main's run "Main" and the pull request's "The PR at".
file: xtask/src/records.rs
in: is_main
find: info.branch == "main"
replace: info.branch == "master"
caught-by:
    records::tests::the_pull_requests_section_is_in_the_records_form

# ------------------------------------------------- the review's fixes

[break] replace-passes-over-an-edge-comment
rule: A match by tokens whose --from begins or ends with a comment is refused, not made beside the file's comment.
file: xtask/src/replace.rs
in: edit
find: && (!request.from[..first.start].trim().is_empty()
replace: && (false
caught-by:
    replace::tests::a_match_by_tokens_that_begins_or_ends_with_a_comment_is_refused

[break] a-file-named-two-ways-is-two-files
rule: A script's file is one file however the script spells it.
file: xtask/src/replace.rs
in: run_script
find: edit.request.file = real.strip_prefix(&here).map_or_else(|_| real.clone(), Path::to_path_buf);
replace: let _ = &real;
caught-by:
    replace::tests::a_file_named_two_ways_is_one_file_and_keeps_its_permissions

[break] a-rewritten-file-loses-its-permissions
rule: A file replace --script rewrites keeps its permissions.
file: xtask/src/replace.rs
in: write_all
find: fs::set_permissions(beside(path), permissions)
replace: { let _ = permissions; Ok(()) }
caught-by:
    replace::tests::a_file_named_two_ways_is_one_file_and_keeps_its_permissions

[break] a-retrys-text-holds-its-output
rule: A failure's text ends at its first nested element: a retry's own output is not part of it.
file: xtask/src/junit.rs
in: child_text
find: unescape(body.split('<').next().unwrap_or(body))
replace: unescape(body)
caught-by:
    junit::tests::a_failures_text_kind_and_standard_error_are_read_and_a_pass_has_none

[break] a-section-loses-the-notes-after-its-end-mark
rule: Writing a ci.md section again keeps everything after what ci-times wrote.
file: xtask/src/records.rs
in: with_section
find: out.push_str(&lines[start + 2 + close..].concat());
replace:
caught-by:
    records::tests::a_section_is_written_between_its_marks_and_the_rest_of_the_page_is_kept

[break] a-resolved-request-is-unexpected
rule: The core rig's Front does not take a request that was resolved for one it must answer.
file: crates/cortex-core/tests/it/main.rs
in: Front::open_approval
find: && !resolved.contains(&id)
replace:
packages: cortex-core
caught-by:
    approvals::a_request_another_client_answered_is_not_unexpected

[break] a-link-in-fenced-code-lists-an-item
rule: A link to an open item inside fenced code or an HTML comment in the index lists nothing.
file: xtask/src/rules/layout.rs
in: unlisted
find: let index = &prose(index);
replace:
caught-by:
    rules::layout::tests::an_item_the_index_does_not_list_once_is_named

[break] a-fenced-heading-starts-a-section
rule: A heading inside fenced code is not one, when ci-times looks for a section.
file: xtask/src/records.rs
in: is_heading
find: *fenced = !*fenced;
replace:
caught-by:
    records::tests::a_section_is_written_between_its_marks_and_the_rest_of_the_page_is_kept
