# The fifth tooling step: stress's failure text, replace --script, the rigs
# that cannot hang on a question, the fake timer's waits in the timeout
# report, the style comparison of the golden screens, the owner's colours,
# the index of the open items, the comma that a find cannot match, the test
# binary in roles and the interrupt hand-off, the runner-like estimate and
# the records written from runs. Written with the code, and run with
# `cargo xtask mutate tooling-5`.

# -------------------------------------------------------------------- stress

[break] stress-drops-a-failures-message
rule: A stress run prints each failing test's message, read from the report.
file: xtask/src/stress.rs
in: summarise
find: text.push_str(&explain(&own, first_seed, report));
replace:
caught-by:
    stress::tests::each_failure_is_shown_by_the_start_of_its_message_with_where_the_rest_is
    stress::tests::a_timeout_shows_what_the_test_wrote_and_a_failure_of_another_kind_is_named

[break] stress-reports-a-pass-for-a-failed-run
rule: A run in which a test failed on some repeat is a failure, whatever nextest's status says.
file: xtask/src/stress.rs
in: conclude
find: if summary.failing > 0 {
replace: if summary.failing > usize::MAX - 1 {
caught-by:
    stress::tests::a_run_found_nothing_only_if_nextest_agrees_and_every_repeat_is_there

[break] a-timeout-shows-no-standard-error
rule: A timeout's failure shows what the test wrote to standard error, where the timeout report is.
file: xtask/src/stress.rs
in: failure_lines
find: &failure.stderr
occurrence: 1
replace: &failure.text
caught-by:
    stress::tests::a_timeout_shows_what_the_test_wrote_and_a_failure_of_another_kind_is_named

[break] a-failures-text-is-not-read
rule: The report's failure text is read from the first failure element of a case.
file: xtask/src/junit.rs
in: failures
find: let (kind, text) = child_text(&children[at..], child);
replace: let (kind, text) = (child_text(&children[at..], child).0, String::new());
caught-by:
    junit::tests::a_failures_text_kind_and_standard_error_are_read_and_a_pass_has_none
    stress::tests::each_failure_is_shown_by_the_start_of_its_message_with_where_the_rest_is

# ------------------------------------------------------------ replace --script

[break] a-script-is-applied-in-part
rule: replace --script makes every edit or none: an edit that cannot be made stops the script before any file is written.
file: xtask/src/replace.rs
in: apply_script
find: let (edited, lines) = edit(&files[index].1, &step.request, &path.display().to_string())
replace: let (edited, lines) = edit(&files[index].1, &step.request, &path.display().to_string()).or_else(|_| Ok::<_, String>((files[index].1.clone(), String::new())))
caught-by:
    replace::tests::a_script_with_one_edit_that_cannot_be_made_is_refused_whole_and_names_it
    replace::tests::a_script_on_real_files_writes_all_of_them_or_none

[break] a-script-edit-does-not-see-the-one-before
rule: Each edit of a script is made on what the edits before it left.
file: xtask/src/replace.rs
in: apply_script
find: files[index].1 = edited;
replace: let _ = edited;
caught-by:
    replace::tests::an_edit_sees_what_the_edits_before_it_left
    replace::tests::every_edit_of_a_script_is_made_in_order

[break] a-script-file-is-not-rust-by-its-name
rule: A .rs file in a script is matched by tokens, any other file by its text.
file: xtask/src/replace.rs
in: parse_script
find: edit.request.text = forced_text || !rust;
replace: edit.request.text = forced_text;
caught-by:
    replace::tests::a_script_is_read_into_its_edits

# ------------------------------------------------------- rigs and the timer

[break] an-unexpected-approval-waits
rule: The core rig's Front fails a test at once on an approval it did not expect and nobody answers.
file: crates/cortex-core/tests/it/main.rs
in: Front::open_approval
find: !answered.contains(id) && !resolved.contains(&id)
replace: false
packages: cortex-core
caught-by:
    approvals::an_approval_the_test_did_not_expect_fails_it_at_once_naming_the_call
    approvals::a_front_answers_by_its_policy_what_the_test_did_not_take_up

[break] an-unscripted-question-is-allowed
rule: The agent rig fails a test on a question it scripted no answer for.
file: crates/cortex-agent/tests/it/main.rs
in: Rig::drop
find: if !asked.is_empty() && !std::thread::panicking() {
replace: if false {
packages: cortex-agent
caught-by:
    denials::a_question_with_no_scripted_answer_fails_the_test_naming_the_call

[break] a-fake-timers-wait-is-not-named
rule: A manual fake timer's wait is named for the timeout report while it runs.
file: crates/cortex-testkit/src/timer.rs
in: FakeTimer::sleep
find: doing: Some(doing)
replace: doing: { drop(doing); None }
caught-by:
    timer::tests::a_running_wait_is_named_for_the_timeout_report_until_it_ends

[break] a-finished-wait-stays-named
rule: A wait that has ended is not named any more, though its future is held.
file: crates/cortex-testkit/src/timer.rs
in: ManualSleep::poll
find: this.doing = None;
replace:
caught-by:
    timer::tests::a_running_wait_is_named_for_the_timeout_report_until_it_ends

# ---------------------------------------------------- screens and colours

[break] the-style-comparison-passes-a-changed-colour
rule: The golden screens compare a cell's style as well as its text.
file: crates/cortex-tui/tests/it/screens/mod.rs
in: same
find: a == b
replace: a.text == b.text && a.tail == b.tail
packages: cortex-tui
caught-by:
    screens::a_changed_colour_weight_or_background_is_found_and_an_unseen_one_is_not

[break] red-green-and-yellow-are-not-bold-on-light
rule: On a light background, status text in red, green or yellow is bold.
file: crates/cortex-tui/src/theme.rs
in: Palette::light
find: warm_bold: true
replace: warm_bold: false
caught-by:
    theme::tests::on_a_light_background_red_green_and_yellow_text_is_bold

[break] keywords-are-magenta-on-dark
rule: On a dark background, and when none is reported, keywords in code are bright blue.
file: crates/cortex-tui/src/theme.rs
in: Palette::dark
find: syntax_keyword: Color::Ansi(12)
replace: syntax_keyword: Color::Ansi(13)
caught-by:
    theme::tests::on_a_dark_background_keywords_are_bright_blue

[break] code-goes-bold-on-light
rule: By the owner's choice, highlighted code and whole changed lines keep their weight on a light background.
file: crates/cortex-tui/src/theme.rs
in: resolve
find: let reached = !wide || palette.warm_bold_code_and_lines;
replace: let reached = true;
caught-by:
    theme::tests::on_a_light_background_red_green_and_yellow_text_is_bold

