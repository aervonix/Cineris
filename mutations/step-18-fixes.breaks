[break] a-matching-lines-tabs-are-escaped
rule: A matching line's tabs are its indentation, and are kept.
file: crates/cortex-tools/src/search.rs
in: FileSink::line
find: let text = String::from_utf8_lossy(bytes); let text = visible_keeping(&text, &['\t']);
replace: let text = String::from_utf8_lossy(bytes); let text = visible_keeping(&text, &[]);
caught-by:
    cortex-tools::it search::a_name_and_a_matching_line_that_act_unseen_are_escapes_and_tabs_are_kept

[break] a-payload-path-is-escaped
rule: A payload's path is data, which programs read back (the files a summary carries): it is as it is.
file: crates/cortex-tools/src/read.rs
find: "path": data
occurrence: 3
replace: "path": shown
caught-by:
    cortex-tools::it read::a_name_that_acts_unseen_is_an_escape_in_the_text_and_as_it_is_in_the_payload

[break] read-names-close-matches-raw
rule: The names read gives as close matches to a missing file are escapes.
file: crates/cortex-tools/src/read.rs
in: missing
find: .map(|name| cortex_base::visible(name).into_owned())
replace: .map(|name| name.clone())
caught-by:
    cortex-tools::it read::a_name_that_acts_unseen_is_an_escape_in_the_text_and_as_it_is_in_the_payload

[break] a-path-refusal-names-the-path-raw
rule: A path the resolver refuses is named in its message as an escape.
file: crates/cortex-base/src/path/mod.rs
find: #[error("`{shown_path}` leads out of the directory it is relative to", shown_path = crate::visible(.path))]
replace: #[error("`{path}` leads out of the directory it is relative to")]
caught-by:
    cortex-base::it paths::a_refusal_writes_the_path_it_names_as_an_escape

# ---------------------------------------------------------------- finding 9

[break] the-index-starts-while-the-session-is-assembled
rule: The index's first pass starts once the session's loop runs, never while the session is put together (the independent review of step 18's break).
file: crates/cortex-core/src/assemble.rs
in: assemble
find: let main = models.main().clone();
replace: if let Some(repo) = &repo { repo.warm(); } let main = models.main().clone();
caught-by:
    cortex-core::it index::the_index_is_not_touched_until_the_session_is_open

# --------------------------------------------------------------- finding 10

[break] a-project-may-set-the-maps-wait
rule: The map's wait is the user's alone: a repository's file must not make the sessions in it wait.
file: crates/cortex-config/src/schema/sections.rs
find: [UserOnly, NextEpoch, 0..=1_000]
replace: [Preference, NextEpoch, 0..=1_000]
caught-by:
    cortex-config::it trust::the_documented_classes_hold
    cortex-config::it trust::every_key_has_a_trust_class

[break] the-maps-wait-has-no-bound
rule: The map's wait is at most one second.
file: crates/cortex-config/src/schema/sections.rs
find: [UserOnly, NextEpoch, 0..=1_000]
replace: [UserOnly, NextEpoch]
caught-by:
    cortex-config validate::tests::a_length_of_time_out_of_range_is_an_error_in_milliseconds

[break] a-length-of-time-is-not-ranged
rule: A length of time with a range is checked against it, in milliseconds.
file: crates/cortex-config/src/validate.rs
in: check_leaf
find: let number = crate::schema::magnitude(value);
replace: let number = match value { Value::Integer(number) => Some(*number as f64), Value::Float(number) => Some(*number), _ => None };
caught-by:
    cortex-config validate::tests::a_length_of_time_out_of_range_is_an_error_in_milliseconds

