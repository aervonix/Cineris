# Step 28, the user's own pins (`pins.toml`, `cineris-policy`'s
# `trust::PinStore`): read strictly, written owner-only and atomically under
# a lock, one pin for each kind and name, and closed to every tool. Each
# rule broken once, with the tests that must fail. Written with the code.

# ------------------------------------------------------------ read strictly

[break] pins-unknown-key-at-the-top-read
rule: The pin store is read strictly: a key this build does not know, at the top of the file, refuses the whole file.
file: crates/cineris-policy/src/trust/pins.rs
find: #[serde(deny_unknown_fields)] struct File
replace: struct File
caught-by:
    pins::a_pin_store_that_is_not_understood_pins_nothing_and_is_left_as_it_is

[break] pins-unknown-key-in-a-pin-read
rule: The pin store is read strictly: a key this build does not know, in a pin, refuses the whole file.
file: crates/cineris-policy/src/trust/pins.rs
find: #[serde(deny_unknown_fields)] pub struct UserPin
replace: pub struct UserPin
caught-by:
    pins::a_pin_store_that_is_not_understood_pins_nothing_and_is_left_as_it_is

[break] pins-newer-version-read
rule: A pin store of a version this build does not read (a newer one) refuses the whole file.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::read
find: if file.version != VERSION {
replace: if file.version < VERSION {
caught-by:
    pins::a_pin_store_that_is_not_understood_pins_nothing_and_is_left_as_it_is

[break] pins-two-of-one-kind-and-name-read
rule: A pin store with two pins of one kind and name, which no build wrote, refuses the whole file: the order must not decide which stands.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::read
find: .any(|earlier| earlier.is_of(&pin.kind, &pin.name))
replace: .any(|earlier| earlier.is_of(&pin.kind, &pin.name) && false)
caught-by:
    pins::a_pin_store_that_is_not_understood_pins_nothing_and_is_left_as_it_is

[break] pins-not-understood-read-as-empty
rule: A pin store that is not understood is an error that says why, and is never read as pinning nothing and then written over.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::read
find: .map_err(|error| self.not_understood(error.message().to_owned()))?;
replace: .unwrap_or(File { version: VERSION, pins: Vec::new() });
caught-by:
    pins::a_pin_store_that_is_not_understood_pins_nothing_and_is_left_as_it_is

[break] pins-missing-file-refused
rule: A missing pin store pins nothing, and is not an error: the first pin makes it.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::read
find: Err(error) if error.kind() == io::ErrorKind::NotFound => {
replace: Err(error) if error.kind() == io::ErrorKind::NotFound && false => {
caught-by:
    pins::a_missing_file_pins_nothing_and_the_first_pin_makes_it

# ------------------------------------------------------------ written owner-only

[break] pins-written-open-to-others
rule: The pin store is written owner-only on every write, a file made by hand that others could read included.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::write
find: owner_only: true
replace: owner_only: false
caught-by:
    pins::every_write_is_owner_only_and_leaves_no_temporary_file

# ------------------------------------------------------------ the lock

[break] pins-lock-let-go-at-once
rule: A change to the pin store holds its lock from the read to the write; a lock taken and let go at once keeps no second writer out.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::update
find: let _lock = store_lock::hold(&self.file)
replace: let _ = store_lock::hold(&self.file)
caught-by:
    trust::pins::tests::every_change_to_the_pins_is_made_under_their_lock
    pins::two_writers_at_once_both_keep_their_pins

[break] pins-lock-let-go-before-the-write
rule: The lock is held until the write is done: a second writer that reads before the first one's write and writes after it loses the first one's pin.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::update
find: if changed { self.write(&file)?; }
replace: drop(_lock); if changed { self.write(&file)?; }
caught-by:
    pins::two_writers_at_once_both_keep_their_pins

[break] pins-no-lock-taken
rule: Every change takes the lock, and a lock that cannot be taken stops the change.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::update
find: store_lock::hold(&self.file).map_err
replace: Ok::<Option<std::fs::File>, io::Error>(None).map_err
caught-by:
    pins::a_lock_that_cannot_be_taken_stops_every_change_and_no_read
    pins::two_writers_at_once_both_keep_their_pins

# ------------------------------------------------------------ one pin for each kind and name

[break] pins-pin-added-beside-the-old
rule: Pinning a definition again replaces the pin of the same kind and name; it never adds a second.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::pin
find: Some(index) => file.pins[index] = pin
replace: Some(_) => file.pins.push(pin)
caught-by:
    pins::pinning_again_replaces_the_pin_of_the_same_kind_and_name

[break] pins-kind-not-compared
rule: A pin is of a kind and a name: the same name of another kind is another thing, neither approved nor replaced by it.
file: crates/cineris-policy/src/trust/pins.rs
in: UserPin::is_of
find: self.kind.as_str() == kind.as_str() && self.name == name
replace: self.name == name
caught-by:
    pins::a_definition_of_the_users_own_stands_by_its_pinned_hash
    pins::pinning_again_replaces_the_pin_of_the_same_kind_and_name

[break] pins-changed-definition-approved
rule: A definition of the user's own whose hash is not the pinned one is changed, and not used.
file: crates/cineris-policy/src/trust/pins.rs
in: UserPins::standing
find: Some(_) => Standing::Changed
replace: Some(_) => Standing::Approved
caught-by:
    pins::a_definition_of_the_users_own_stands_by_its_pinned_hash
    pins::pinning_again_replaces_the_pin_of_the_same_kind_and_name

# ------------------------------------------------------------ the protection

[break] state-directory-not-closed
rule: The state directory is closed to every tool, whole: the user's pins and the trust store with it, so that no model can approve its own change.
file: crates/cineris-core/src/assemble.rs
find: protected = protected.closed(state);
replace: let _ = state;
packages: cineris-core
caught-by:
    cineris-core::it start::the_state_directory_is_closed_whole_to_every_tool
