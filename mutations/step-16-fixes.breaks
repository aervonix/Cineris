# ----------------------------------------------- finding 4: the zone's counts

[break] the-zone-reader-allocates-before-it-checks
rule: The TZif reader allocates nothing for counts the file does not hold.
file: crates/cortex-base/src/zone/tzif.rs
in: Transitions::parse
find: let data_end = header.data_end(start, time_len, bytes.len())?;
replace: let data_end = start + header.data_len(time_len).unwrap_or(0);
caught-by:
    cortex-base::it zone::a_zone_file_that_lies_about_its_counts_is_refused_without_a_large_allocation

[break] the-first-block-is-trusted
rule: A first block whose counts the file does not hold is refused.
file: crates/cortex-base/src/zone/tzif.rs
in: Transitions::parse
find: let second_at = first.data_end(Header::LEN, 4, bytes.len())?;
replace: let second_at = Header::LEN + first.data_len(4)?;
caught-by:
    cortex-base::it zone::a_zone_file_shorter_than_its_counts_is_refused

