# ----------------------------------------------------- the notes, fixed

[break] a-sum-overflows
rule: Sums saturate: a provider's huge count stops at the most a figure holds and the writer goes on.
file: crates/cortex-stats/src/aggregate.rs
in: UsageSum::add
find: self.input = self.input.saturating_add(other.input);
replace: self.input += other.input;
caught-by:
    cortex-stats::it store::sums_that_would_overflow_stop_at_the_most_a_figure_holds

[break] a-stopped-writer-is-invisible
rule: An event sent to a writer that has stopped is dropped and counted.
file: crates/cortex-stats/src/recorder.rs
in: Recorder::send
find: Err(TrySendError::Disconnected(_)) => { self.queued.fetch_sub(1, Ordering::Relaxed); self.dropped.fetch_add(1, Ordering::Relaxed); self.tell_stopped(); }
replace: Err(TrySendError::Disconnected(_)) => { self.queued.fetch_sub(1, Ordering::Relaxed); }
caught-by:
    cortex-stats recorder::tests::a_writer_that_stopped_is_counted_not_hidden

[break] an-unknown-range-is-all-time
rule: A range this build does not know is refused, not answered as all time.
file: crates/cortex-core/src/usage.rs
in: report
find: if let UsageRange::Unknown(other) = &params.range {
replace: if let UsageRange::Unknown(other) = &params.range && false {
caught-by:
    cortex-core::it usage::a_range_this_build_does_not_know_is_refused

