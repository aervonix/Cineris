# Step 28, `cineris.state`: an extension's own values, its `session` ones in
# the session's log (a resume has them as the session left them, a fork as
# they were at its point) and its `project` ones in a file of the state
# directory (read strictly, written owner-only and atomically), keyed by
# where the extension comes from and its name, and held to their caps. Each
# rule broken once, with the tests that must fail. Written with the code.

# ------------------------------------------------------------- the contract

[break] state-key-counted-in-characters
rule: A key is at most 256 bytes, counted in bytes, not characters.
file: crates/cineris-ext/src/host.rs
in: check_key
find: key.is_empty() || key.len() > STATE_MAX_KEY
replace: key.is_empty() || key.chars().count() > STATE_MAX_KEY
caught-by:
    cineris-ext::it serve::a_key_is_one_to_256_bytes

[break] state-key-may-be-empty
rule: A key is at least one byte.
file: crates/cineris-ext/src/host.rs
in: check_key
find: key.is_empty() || key.len() > STATE_MAX_KEY
replace: key.len() > STATE_MAX_KEY
caught-by:
    cineris-ext::it serve::a_key_is_one_to_256_bytes

[break] state-set-to-null-is-kept
rule: A set to `null` removes the key: a stored value is never `null`.
file: crates/cineris-ext/src/host.rs
in: serve
find: let value = value.filter(|value| !value.is_null());
replace: let value = value.or(None);
caught-by:
    cineris-ext::it serve::a_value_needs_no_capability_and_a_set_to_null_removes_it

[break] state-sets-without-end-in-a-call
rule: A call of an extension makes at most a hundred `cineris.state.set` calls: each `session` one is a line of the session's log.
file: crates/cineris-ext/src/engine/thread.rs
find: const MAX_STATE_SET: u32 = 100;
replace: const MAX_STATE_SET: u32 = 1000;
packages: cineris-core
caught-by:
    cineris-core::it ext_state::a_call_sets_at_most_a_hundred_values

[break] state-sets-counted-across-calls
rule: Each call of an extension has its own hundred sets.
file: crates/cineris-ext/src/engine/thread.rs
in: Shared::begin
find: self.stored = 0;
replace: let _ = self.stored;
packages: cineris-core
caught-by:
    cineris-core::it ext_state::a_call_sets_at_most_a_hundred_values

# ---------------------------------------------------------- whose values

[break] state-session-values-keyed-by-name-alone
rule: An extension's `session` values are keyed by where it comes from and its name.
