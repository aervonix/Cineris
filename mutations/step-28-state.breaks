    cineris-core ext::state::tests::only_a_records_state_is_a_change_of_a_value

# The session store's change: `Log::fork` copies the `ext` records written
# before the fork's point, so the fork's log holds the values as they were
# there, and a resume of the fork reads them from it.

[break] fork-does-not-copy-the-extensions-records
rule: `Log::fork` copies an extension's records written before the fork's point: the fork, and a resume of it, have its `session` values as they were there.
file: crates/cineris-session/src/session.rs
in: Log::fork
find: copied.extend(self.record_indices(&Kind::Ext).into_iter().filter(|&index| until.is_none_or(|until| index < until)));
replace: let _ = until;
packages: cineris-session,cineris-core
caught-by:
    cineris-session::it tree::a_fork_copies_the_extensions_records_written_before_its_point
    cineris-core::it ext_state::a_fork_has_the_values_as_they_were_at_its_point_and_neither_sees_the_others_sets
    cineris-core::it ext_state::a_resumed_fork_has_the_values_as_they_were_at_the_fork

[break] fork-copies-records-past-its-point
rule: A fork has an extension's values as they were at its point, not as they are now.
file: crates/cineris-session/src/session.rs
in: Log::fork
find: .filter(|&index| until.is_none_or(|until| index < until))
replace: .filter(|&index| until.is_none_or(|_| index > 0))
packages: cineris-session,cineris-core
caught-by:
    cineris-session::it tree::a_fork_copies_the_extensions_records_written_before_its_point
    cineris-core::it ext_state::a_fork_has_the_values_as_they_were_at_its_point_and_neither_sees_the_others_sets
    cineris-core::it ext_state::a_resumed_fork_has_the_values_as_they_were_at_the_fork

[break] fork-stops-records-at-the-point-itself
rule: An extension's record written after a fork's point, before the conversation went on, is still the state there.
file: crates/cineris-session/src/session.rs
in: Log::fork
find: .and_then(|at| self.next_tree_index(at))
replace: .and_then(|at| Some(at))
caught-by:
    cineris-session::it tree::a_fork_copies_the_extensions_records_written_before_its_point

# ------------------------------------------------- the project's values

[break] state-project-values-not-read
rule: A project's values are read from its file: the next session of the project has them.
file: crates/cineris-core/src/ext/state.rs
in: ExtState::project_get
find: Ok(read_file(&path, &shown)?.remove(key))
replace: Ok(read_file(&path, &shown)?.remove(key).filter(|_| false))
caught-by:
    cineris-core::it ext_state::a_project_value_is_seen_by_the_next_session_of_the_project

[break] state-project-values-shared-by-every-project
rule: A project's values are kept in that project's folder of the state directory: another project does not see them.
file: crates/cineris-core/src/ext/state.rs
in: ProjectStore::new
find: let dir = state.project_dir(project)?.join("extensions");
replace: let dir = state.project_dir(project)?.parent()?.join("extensions");
caught-by:
    cineris-core::it ext_state::a_project_value_is_not_seen_by_another_project

[break] state-project-file-of-another-version-read
rule: A project's file is read strictly: one of another version, a newer one among them, is refused and never read as this build's.
file: crates/cineris-core/src/ext/state.rs
in: parse_file
find: Some(FILE_VERSION) => {}
replace: Some(_) => {}
caught-by:
    cineris-core::it ext_state::a_project_file_this_build_did_not_write_is_refused_and_left_as_it_is
    cineris-core ext::state::tests::a_file_this_build_did_not_write_is_refused_with_the_reason

[break] state-project-file-unknown-field-taken
rule: A project's file is read strictly: a field this build does not know refuses it.
file: crates/cineris-core/src/ext/state.rs
in: parse_file
find: .find(|name| !matches!(name.as_str(), "version" | "values"))
replace: .find(|_| false)
caught-by:
    cineris-core::it ext_state::a_project_file_this_build_did_not_write_is_refused_and_left_as_it_is
    cineris-core ext::state::tests::a_file_this_build_did_not_write_is_refused_with_the_reason

[break] state-project-file-read-past-its-bound
rule: A project's file larger than any this build writes is refused, not read.
