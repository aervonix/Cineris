# ------------------------------------------------------------ scratch-test

[break] scratch-test-leaves-its-module-in-the-copy
rule: The copy is the worktree again after a scratch test, pass or fail.
file: xtask/src/scratch_test.rs
in: scratch_test
find: let tidied = crate::mutate::sync(root, &copy, &files);
replace: let tidied: Result<()> = Ok(());
caught-by:
    scratch_test::tests::the_file_runs_in_a_copy_and_nothing_is_left_behind

[break] scratch-test-writes-in-the-worktree
rule: A scratch test is placed in the copy, never in the worktree.
file: xtask/src/scratch_test.rs
in: scratch_test
find: let copy = scratch.join("tree");
replace: let copy = root.to_path_buf();
caught-by:
    scratch_test::tests::the_file_runs_in_a_copy_and_nothing_is_left_behind

# -------------------------------------------------------------- live

[break] a-headless-run-goes-on-without-its-key
rule: live --headless stops, saying so, when the provider's key file is not named.
file: xtask/src/outside.rs
in: headless_tests
find: require_key_file_in(provider, var)?;
replace:
caught-by:
    outside::tests::a_headless_run_without_its_key_says_so_and_stops

# ---------------------------------------------------------- replace --text

[break] text-found-twice-is-replaced
rule: replace --text refuses a text that is there more than once.
file: xtask/src/replace.rs
in: edit_text
find: [at] => *at..*at + request.from.len(),
replace: [at, ..] => *at..*at + request.from.len(),
caught-by:
    replace::tests::text_is_replaced_exactly_once_or_not_at_all
