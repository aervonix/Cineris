# ------------------------------------------------------------ scratch-test

[break] scratch-test-leaves-its-module-in-the-copy
rule: The copy is the worktree again after a scratch test, pass or fail.
file: xtask/src/scratch_test.rs
in: scratch_test
find: let tidied = crate::mutate::sync(root, &copy, &files);
replace: let tidied: Result<()> = Ok(());
caught-by:
    scratch_test::tests::the_file_runs_in_a_copy_and_nothing_is_left_behind

[break] scratch-test-writes-in-the-worktree
rule: A scratch test is placed in the copy, never in the worktree.
file: xtask/src/scratch_test.rs
in: scratch_test
find: let copy = scratch.join("tree");
replace: let copy = root.to_path_buf();
caught-by:
    scratch_test::tests::the_file_runs_in_a_copy_and_nothing_is_left_behind

