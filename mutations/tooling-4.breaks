# --------------------------------------------------------- the profile

[break] the-profile-reads-the-clock-when-off
rule: With CORTEX_TESTKIT_PROFILE unset, a mark describes nothing and reads no clock.
file: crates/cortex-testkit/src/profile.rs
in: Mark::start
find: open: recorder().map(|_| (kind, what(), Instant::now()))
replace: open: Some((kind, what(), Instant::now()))
caught-by:
    cortex-testkit profile::tests::off_it_reads_no_clock_and_keeps_nothing

[break] a-phase-is-counted-twice
rule: The time in phases counts each stretch once, however phases nest.
file: crates/cortex-testkit/src/profile.rs
in: union
find: let (start, end) = (start.max(reached), end.min(to));
replace: let (start, end) = (start, end.min(to));
caught-by:
    cortex-testkit profile::tests::a_report_lists_the_phases_and_waits_in_order_with_the_start

# ------------------------------------------------------ the pressure helper

[break] preparing-is-sized-past-the-trigger
rule: Fill::Preparing puts the estimate between the background threshold and the trigger.
file: crates/cortex-agent/tests/it/main.rs
in: Rig::fill
find: Fill::Preparing => (prepare, compact),
replace: Fill::Preparing => (compact, limit as f64),
caught-by:
    cortex-agent::it pressure::preparing_starts_a_summary_in_the_background

[break] the-twin-ignores-the-instructions
rule: The twin reads the session's instruction files, so they are counted in the request's size.
file: crates/cortex-agent/tests/it/main.rs
in: Rig::measure
find: setup.instructions = Arc::clone(&self.twin.instructions);
replace:
caught-by:
    cortex-agent::it pressure::the_twin_counts_the_tools_and_the_instructions

