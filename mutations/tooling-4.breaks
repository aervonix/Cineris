# ---------------------------------------------------------- replace --text

[break] text-found-twice-is-replaced
rule: replace --text refuses a text that is there more than once.
file: xtask/src/replace.rs
in: edit_text
find: [at] => *at..*at + request.from.len(),
replace: [at, ..] => *at..*at + request.from.len(),
caught-by:
    replace::tests::text_is_replaced_exactly_once_or_not_at_all

