# ------------------------------------------------------- paths by place

[break] two-different-paths-are-one-place
rule: Two Windows paths whose names differ are two places.
file: crates/cineris-base/src/path/location.rs
in: PathStyle::same_location
find: .all(|(one, other)| self.same_name(one, other))
replace: .all(|_| true)
caught-by:
    cineris-base path::location::tests::a_path_that_differs_by_one_character_is_another_place

[break] the-unc-form-is-not-read
rule: The extended-length form of a share, \\?\UNC\server\share, is read as \\server\share.
file: crates/cineris-base/src/path/location.rs
in: Place::read
find: let (root, rest) = if let Some(rest) = strip_verbatim(text, "UNC\\") {
replace: let (root, rest) = if let Some(rest) = strip_verbatim(text, "UNC\\").filter(|_| false) {
caught-by:
    cineris-base path::location::tests::windows_reads_the_extended_length_forms_as_the_plain_ones

[break] case-is-not-folded
rule: On Windows names are compared with case folded.
file: crates/cineris-base/src/path/location.rs
in: PathStyle::location_within
find: .all(|(one, other)| self.same_name(one, other))
replace: .all(|(one, other)| one == other)
caught-by:
    cineris-base path::location::tests::within_is_by_whole_names_and_by_place

[break] the-home-folder-is-stripped-by-text
rule: A resolved path under the home folder is shown with ~ on Windows, whatever its form and case.
file: crates/cineris-config/src/env.rs
in: Env::display_path
find: && let Some(inside) = style.strip_location_prefix(path, &home)
replace: && let Some(inside) = path.strip_prefix(&home).ok().map(Path::to_path_buf).filter(|_| style == style)
caught-by:
    cineris-config env::tests::a_path_under_the_home_directory_is_shown_with_a_tilde

