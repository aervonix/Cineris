# The seventh tooling step, the part on hostile names: the one set in the test
# kit (`cortex_testkit::hostile`) and the tests moved onto it. Written with the
# code, and run with `cargo xtask mutate tooling-7-names`.

# ------------------------------------------------------------------ the set

[break] names-a-line-feed-that-differs-by-system
rule: The set has no cfg: an entry is the same on every system, so what a test checks does not depend on where it runs.
file: crates/cortex-testkit/src/hostile.rs
in: line_breaks
find: one(Kind::LineBreak, "LF line feed", '\n')
replace: one(Kind::LineBreak, "LF line feed", if cfg!(windows) { '\u{2028}' } else { '\n' })
caught-by:
    cortex-testkit hostile::tests::the_set_has_no_cfg_that_changes_it

[break] names-a-kind-with-no-entries
rule: Every kind of hostile name has entries.
file: crates/cortex-testkit/src/hostile.rs
in: of
find: Kind::Replacement => replacement()
replace: Kind::Replacement => Vec::new()
caught-by:
    cortex-testkit hostile::tests::every_kind_has_entries_and_all_is_all_of_them

[break] names-the-line-breaks-lose-crlf
rule: The line breaks are LF, CR, CRLF, NEL, U+2028 and U+2029, all six.
file: crates/cortex-testkit/src/hostile.rs
in: line_breaks
find: Name::new(Kind::LineBreak, "CRLF", "\r\n").shown("\\r\\n")
replace:
caught-by:
    cortex-testkit hostile::tests::the_line_breaks_are_the_six_and_only_the_six

[break] names-a-bidi-entry-that-is-not-a-control
rule: An entry of the bidi kind holds a bidirectional control, and every control of the family is there alone.
file: crates/cortex-testkit/src/hostile.rs
in: bidi
find: ('\u{061C}', "ALM arabic letter mark")
replace: ('\u{0041}', "ALM arabic letter mark")
caught-by:
    cortex-testkit hostile::tests::a_bidi_entry_holds_a_bidirectional_control

[break] names-a-format-entry-that-is-not-format
rule: An entry of the format kind holds a character of Unicode's category Cf.
file: crates/cortex-testkit/src/hostile.rs
in: format_characters
find: ('\u{FEFF}', "byte-order mark")
replace: ('\u{0041}', "byte-order mark")
caught-by:
    cortex-testkit hostile::tests::a_format_entry_holds_a_format_character_and_the_tags_are_among_them

[break] names-a-control-set-without-del
rule: The control entries are all of C0 but the line breaks, DEL, and all of C1 but NEL, each alone.
file: crates/cortex-testkit/src/hostile.rs
in: control
find: (0x00..=0x1Fu32).chain([0x7F]).chain(0x80..=0x9F)
replace: (0x00..=0x1Fu32).chain(0x80..=0x9F)
caught-by:
    cortex-testkit hostile::tests::a_control_entry_is_a_control_character_that_is_not_a_line_break

[break] names-a-long-name-of-the-wrong-length
rule: A long name has the length its label claims.
file: crates/cortex-testkit/src/hostile.rs
in: long
find: repeated("255 bytes of ASCII, the most a name holds on Linux", "a", 255)
replace: repeated("255 bytes of ASCII, the most a name holds on Linux", "a", 254)
caught-by:
    cortex-testkit hostile::tests::a_long_name_has_the_length_it_claims

[break] names-a-device-that-is-not-one
rule: An entry of the reserved kind is a name Windows keeps for a device, in a form it still takes for it.
file: crates/cortex-testkit/src/hostile.rs
in: reserved
find: add("CONIN$".into(), "CONIN$".into());
replace: add("CONIN$".into(), "CONINX".into());
caught-by:
    cortex-testkit hostile::tests::a_reserved_entry_is_a_windows_device_in_a_form_windows_still_takes_for_it

[break] names-an-entry-shown-as-it-is
rule: What an entry says it is shown as is how the harness shows it, so the function is checked against something that is not itself.
file: crates/cortex-testkit/src/hostile.rs
in: one
find: Name::new(kind, label, character.to_string()).shown(escape(character))
replace: Name::new(kind, label, character.to_string())
caught-by:
    cortex-testkit hostile::tests::every_entry_is_shown_as_it_says

[break] names-a-slash-in-an-escape-entry
rule: A name holds no slash, but the punctuation that is about paths on purpose.
file: crates/cortex-testkit/src/hostile.rs
in: escapes
find: "\u{1b}]8;;link.invalid\u{1b}\\link\u{1b}]8;;\u{1b}\\"
replace: "\u{1b}]8;;https://link.invalid/\u{1b}\\link\u{1b}]8;;\u{1b}\\"
caught-by:
    cortex-testkit hostile::tests::only_a_punctuation_entry_holds_a_slash

[break] names-a-probe-that-takes-every-name
rule: Whether a file system takes a name is known by making the file and reading back what the directory holds.
file: crates/cortex-testkit/src/hostile.rs
in: takes_file_name
find: let exact = made && held.len() == 1 && held[0].as_os_str() == std::ffi::OsStr::new(name);
replace: let exact = true;
caught-by:
    cortex-testkit hostile::tests::a_file_system_that_takes_a_name_is_known_by_making_the_file

[break] names-a-probe-that-leaves-its-directory
rule: The probe's directory is removed again.
file: crates/cortex-testkit/src/hostile.rs
in: takes_file_name
find: let _ = std::fs::remove_dir_all(&probe);
replace:
caught-by:
    cortex-testkit hostile::tests::a_file_system_that_takes_a_name_is_known_by_making_the_file

[break] names-a-test-that-checks-no-name
rule: A test that makes files fails when the file system takes none of the line breaks, so that it cannot check nothing and pass.
file: crates/cortex-tools/tests/it/main.rs
in: breaks_in_names
find: .filter(|name| hostile::takes_file_name(&ws.dir, &format!("x{}y", name.text)))
replace: .filter(|_| false)
caught-by:
    cortex-tools::it list::a_name_that_acts_unseen_is_listed_as_an_escape_and_a_link_of_such_a_name_resolves
    cortex-tools::it read::a_name_that_acts_unseen_is_an_escape_in_the_text_and_as_it_is_in_the_payload
    cortex-tools::it search::a_name_and_a_matching_line_that_act_unseen_are_escapes_and_tabs_are_kept
    cortex-tools::it outline::a_directory_named_to_start_lines_of_its_own_is_an_escape_in_every_message

# ------------------------------------------------- the tests moved onto it

[break] names-the-tools-show-a-path-as-it-is
rule: A path the tools show is written with every character that acts unseen as an escape, for every line break of the set and not for one.
file: crates/cortex-tools/src/args.rs
in: shown
find: cortex_base::visible(&text).into_owned()
replace: text
caught-by:
    cortex-tools::it list::a_name_that_acts_unseen_is_listed_as_an_escape_and_a_link_of_such_a_name_resolves
    cortex-tools::it read::a_name_that_acts_unseen_is_an_escape_in_the_text_and_as_it_is_in_the_payload
    cortex-tools::it search::a_name_and_a_matching_line_that_act_unseen_are_escapes_and_tabs_are_kept
    cortex-tools::it outline::a_directory_named_to_start_lines_of_its_own_is_an_escape_in_every_message

[break] names-a-skipped-entrys-error-is-not-escaped
rule: What the walk says of an entry it could not read names it as an escape, and a line break in it does not cut the reason short.
file: crates/cortex-tools/src/walk.rs
in: Skipped::unreadable
find: let escaped = cortex_base::visible(reason);
replace: let escaped = std::borrow::Cow::Borrowed(reason);
caught-by:
    cortex-tools walk::tests::a_skipped_entrys_reason_names_it_as_an_escape

[break] names-a-skipped-entrys-refusal-is-not-escaped
rule: What the walk says of an entry whose name was refused names it as an escape.
file: crates/cortex-tools/src/walk.rs
in: Skipped::refuse
find: cortex_base::visible(&reason).into_owned()
replace: reason
caught-by:
    cortex-tools walk::tests::a_skipped_entrys_reason_names_it_as_an_escape

[break] names-the-engines-reasons-are-not-escaped
rule: A reason names a path from the workspace as an escape, so that it cannot start lines of its own.
file: crates/cortex-policy/src/engine.rs
in: escaped
find: match cortex_base::visible(&reason) {
replace: match std::borrow::Cow::Borrowed(reason.as_str()) {
caught-by:
    cortex-policy::it files::a_reason_writes_the_path_it_names_as_an_escape

[break] names-an-outlines-head-is-not-escaped
rule: A head is shown through `cortex_base::visible`.
file: crates/cortex-index/src/outline.rs
in: Outline::render
find: visible(&entry.head)
replace: &entry.head
caught-by:
    cortex-index outline::tests::an_outline_shows_what_would_act_unseen_as_escapes

[break] names-an-outlines-doc-is-not-escaped
rule: A doc is shown through `cortex_base::visible`.
file: crates/cortex-index/src/outline.rs
in: Outline::render
find: let _ = write!(text, "  — {}", visible(doc));
replace: let _ = write!(text, "  — {}", doc);
caught-by:
    cortex-index outline::tests::an_outline_shows_what_would_act_unseen_as_escapes

[break] names-the-presenter-draws-a-control-character
rule: Content cannot write an escape sequence: every control character of the hostile set is drawn as a symbol.
file: crates/cortex-term/src/sanitize.rs
in: sanitize
find: _ => out.push(visible(c).unwrap_or(c))
replace: _ => out.push(c)
caught-by:
    cortex-term::it presenter::no_escape_sequence_or_control_character_of_the_hostile_set_is_obeyed

[break] names-unix-refuses-a-windows-device-name
rule: A Unix path takes every name of the hostile set that Windows keeps for a device, as it takes any other.
file: crates/cortex-base/src/path/lexical.rs
in: check_name
find: if style == PathStyle::Posix {
replace: if false {
packages: cortex-base, cortex-tools
caught-by:
    cortex-tools::it paths_unix::names_that_only_windows_refuses_are_ordinary_here
