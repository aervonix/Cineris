# The eighth tooling step's test-kit part: the exit-status matcher, glyph-set
# matching, `Session::close_console`, the App-frame snapshot helper and the
# compaction tests sized from the measured prompt.

# The exit-status matcher.

[break] the-exit-code-wording-is-not-read
rule: Windows' wording of an exit code (`exit code: N`) is read as Unix's (`exit status: N`) is.
file: crates/cortex-testkit/src/exit.rs
in: Exit::parse
find: .or_else(|| text.strip_prefix("exit code:"))
replace: .or_else(|| text.strip_prefix("exit status:"))
caught-by:
    exit::tests::both_systems_wordings_of_a_code_read_the_same

[break] a-windows-fault-is-read-as-a-code
rule: A Windows status with the high bit set is a fault, not an exit code.
file: crates/cortex-testkit/src/exit.rs
in: from_windows
find: Err(_) => Self::Fault(raw)
replace: Err(_) => Self::Code(0)
caught-by:
    exit::tests::a_signal_and_a_windows_fault_are_not_a_code

[break] a-signal-is-read-as-a-code
rule: A signal's end is not an exit code.
file: crates/cortex-testkit/src/exit.rs
in: Exit::parse
find: .map(Self::Signal)
replace: .map(Self::Code)
caught-by:
    exit::tests::a_signal_and_a_windows_fault_are_not_a_code

[break] the-first-verdict-is-read-not-the-last
rule: A screen that holds several verdicts is read at its last.
file: crates/cortex-testkit/src/exit.rs
in: Verdict::parse
find: text.lines().rev().find_map
replace: text.lines().find_map
caught-by:
    exit::tests::the_last_verdict_is_the_one_read

[break] a-restoration-that-failed-is-read-as-done
rule: A verdict of `restored: NO` is read as not restored.
file: crates/cortex-testkit/src/exit.rs
in: Verdict::parse
find: Some((false, line.split_once(NOT_RESTORED)?.1))
replace: Some((true, line.split_once(NOT_RESTORED)?.1))
caught-by:
    exit::tests::the_shells_verdict_is_read_from_a_screen_with_either_wording

# Glyph-set matching.

[break] only-the-first-glyph-set-is-tried
rule: Text spelled once is found in whichever glyph set the screen was drawn in.
file: crates/cortex-testkit/src/glyphs.rs
in: GlyphSets::shows
find: self.sets.iter().any(|set| term.shows(&spell(set)))
replace: self.sets.iter().take(1).any(|set| term.shows(&spell(set)))
caught-by:
    glyphs::tests::text_spelled_once_is_found_in_either_set

[break] a-rows-start-is-matched-anywhere
rule: A row pattern's start is where the row starts, after its margin, not anywhere in it.
file: crates/cortex-testkit/src/glyphs.rs
in: RowPattern::matches
find: row.trim_start().starts_with(start.as_str())
replace: row.contains(start.as_str())
caught-by:
    glyphs::tests::a_rows_start_is_matched_after_its_margin_and_a_set_is_not_mixed_with_another

[break] a-row-pattern-needs-only-one-of-its-texts
rule: A row pattern matches a row that holds every one of its texts.
file: crates/cortex-testkit/src/glyphs.rs
in: RowPattern::matches
find: self.contains.iter().all(|text| row.contains(text.as_str()))
replace: self.contains.iter().any(|text| row.contains(text.as_str()))
caught-by:
    glyphs::tests::a_row_pattern_needs_every_text_it_holds

# The console closing.

[break] the-hang-up-sends-another-signal
rule: Closing the console on Unix hangs up on the program with SIGHUP.
file: crates/cortex-term/src/sys/unix.rs
in: hang_up
find: for signal in [libc::SIGHUP, libc::SIGCONT]
replace: for signal in [libc::SIGTERM, libc::SIGCONT]
packages: cortex-testkit
caught-by:
    pty::close::tests::sys_closing_the_console_hangs_up_on_the_program_which_ends_as_it_asks
    pty::close::tests::sys_a_program_that_does_not_trap_the_hang_up_ends_by_the_signal

[break] closing-the-console-of-an-ended-program-is-an-error
rule: Hanging up on a program that has already ended is not an error.
file: crates/cortex-term/src/sys/unix.rs
in: hang_up
find: Err(error) if error.raw_os_error() == Some(libc::ESRCH) => {}
replace: Err(error) if error.raw_os_error() == Some(libc::EPERM) => {}
packages: cortex-testkit
caught-by:
    pty::close::tests::sys_closing_the_console_of_a_program_that_has_ended_is_not_an_error

[break] closing-the-console-does-nothing
rule: `Session::close_console` closes the terminal under the program.
file: crates/cortex-testkit/src/pty/close.rs
in: close_console
find: .close_console()
replace: .try_wait().map(drop)
packages: cortex-testkit
caught-by:
    pty::close::tests::sys_closing_the_console_hangs_up_on_the_program_which_ends_as_it_asks

[break] the-shell-does-not-live-through-the-hang-up
rule: A shell that asks to survive the hang-up does, so that it can say how its child ended.
file: crates/cortex-testkit/src/role.rs
in: ModeShell::run
find: if self.surviving_hangup {
replace: if false {
packages: cortex-cli
caught-by:
    cortex-cli::system tui::sys_the_console_closing_ends_the_application_and_stops_its_turn
    cortex-cli::system tui::sys_the_console_closing_stops_a_running_command

[break] the-application-does-not-handle-a-hang-up
rule: A hang-up of the terminal ends the application as SIGTERM does: the terminal is put back, the turn is stopped and the core ends.
file: crates/cortex-term/src/sys/unix.rs
find: libc::SIGHUP, libc::SIGINT
replace: libc::SIGUSR2, libc::SIGINT
packages: cortex-cli
caught-by:
    cortex-cli::system tui::sys_the_console_closing_ends_the_application_and_stops_its_turn
    cortex-cli::system tui::sys_the_console_closing_stops_a_running_command

[break] windows-closes-no-console
rule: Closing the console on Windows closes the pseudo-console under the program.
os: windows
file: crates/cortex-term/src/sys/windows.rs
in: hang_up
find: unsafe { ClosePseudoConsole(console) };
replace: let _ = console;
packages: cortex-cli
caught-by:
    cortex-cli::system tui::sys_the_console_closing_ends_the_application_and_stops_its_turn
    cortex-cli::system tui::sys_the_console_closing_stops_a_running_command

# The App-frame snapshot helper.

[break] an-app-frame-is-drawn-at-the-size-it-had
rule: The App-frame snapshot helper draws the application at the size it is asked for.
file: crates/cortex-tui/src/testing.rs
in: app_frame
find: app.resize(columns.saturating_sub(1), rows);
replace: let _ = (columns, rows);
caught-by:
    app::tests::an_app_frame_snapshot_is_drawn_at_the_size_it_is_asked_for

[break] an-app-frame-leaves-out-the-committed-lines
rule: An App-frame snapshot holds the lines the frame committed to the scrollback.
file: crates/cortex-tui/src/testing.rs
in: app_frame
find: out.push_str(&markup(&commit));
replace: let _ = &commit;
caught-by:
    app::tests::a_dialog_takes_keys_and_shows_its_answers_only_after_its_grace

# Compaction tests sized from the measured prompt.

[break] a-compaction-is-never-triggered
rule: A request past the compaction trigger is compacted before it is sent; the tests' notices are sized past the trigger by `Rig::fill`.
file: crates/cortex-agent/src/turn/epochs.rs
in: trigger
find: (asked, false)
replace: (asked.saturating_mul(3), false)
caught-by:
    sessions::a_compaction_is_shown_as_it_starts_and_ends
    interrupt::interrupted_while_compacting
    summaries::a_summary_with_a_reasoning_budget_keeps_its_whole_output_in_reserve
