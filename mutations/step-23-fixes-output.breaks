# The fixes of what the review of step 23 found in what reaches the
# terminal and the clipboard: their rules broken one at a time, with the
# tests that must fail. Written with the code.

[break] an-entity-brings-back-what-acts-unseen
rule: The character a numeric entity in a model's markdown stands for is made safe as content's is: a bidirectional override, a tag character or a zero-width space from `&#x202E;` is drawn as its escape.
file: crates/cortex-tui/src/markdown/inline.rs
find: _ => cortex_term::sanitize(ch.encode_utf8(&mut [0; 4])).into_owned()
replace: _ => cortex_term::sanitize::visible(ch).map_or(ch.to_string(), |symbol| symbol.to_string())
caught-by:
    markdown::inline::tests::escapes_entities_and_breaks
    markdown::tests::content_reaches_no_line_unsanitised_and_no_line_is_too_wide

[break] the-rest-of-a-line-sanitised-alone
rule: The rest of a line part of which a paragraph already has is sanitised as it reads after the part given: an emoji's selector that came in the next piece is kept, as in the whole answer.
file: crates/cortex-tui/src/markdown/mod.rs
in: Markdown::rest_of_line
find: sanitize_after(before, &raw[taken..])
replace: sanitize_after(before.filter(|_| false), &raw[taken..])
caught-by:
    markdown::tests::an_emoji_selector_in_the_next_piece_is_drawn_as_in_the_whole

[break] a-piece-of-a-line-sanitised-alone
rule: A piece of a line given to a paragraph before the line ends is sanitised as it reads after the piece before it.
file: crates/cortex-tui/src/markdown/mod.rs
in: Markdown::partial
find: sanitize_after(before, &self.pending[taken..usable])
replace: sanitize_after(before.filter(|_| false), &self.pending[taken..usable])
caught-by:
    markdown::tests::an_emoji_selector_in_the_next_piece_is_drawn_as_in_the_whole

[break] a-lines-first-piece-sanitised-without-its-marks
rule: The first piece of a line given to a paragraph is sanitised as it reads after the container marks before it, as the whole line is.
file: crates/cortex-tui/src/markdown/mod.rs
in: Markdown::partial
find: sanitize_after(before, &self.pending[start..usable])
replace: sanitize_after(before.filter(|_| false), &self.pending[start..usable])
caught-by:
    markdown::tests::an_emoji_selector_in_the_next_piece_is_drawn_as_in_the_whole

[break] a-piece-forgets-the-character-before-it
rule: A piece of a longer text, escaped after the character before it, keeps a variation selector at its start when that character is shown as it is: pieces read as the whole does.
file: crates/cortex-base/src/visible.rs
in: visible_keeping_after
find: let mut base = before.is_some_and(|c| !is_selector(c) && !acts_unseen(c) && !keep.contains(&c));
replace: let mut base = before.is_some_and(|_| false);
packages: cortex-base, cortex-term
caught-by:
    visible::tests::a_piece_escaped_after_the_one_before_reads_as_the_whole_does
    sanitize::tests::a_piece_reads_after_the_character_before_it

[break] copy-copies-the-raw-answer
rule: `/copy` puts on the clipboard the answer with its control characters dropped (but the line feed and the tab) and what acts unseen escaped, never the raw text.
file: crates/cortex-tui/src/app/state/commands.rs
find: for_clipboard(self.mapper.last_answer())
replace: self.mapper.last_answer().to_owned()
caught-by:
    app::tests::output::copy_drops_control_characters_and_escapes_what_acts_unseen
    app::tests::output::copy_of_an_answer_of_control_characters_copies_nothing

[break] copy-keeps-control-characters
rule: A control character on the clipboard would be typed when pasted into a terminal: `/copy` drops every one but the line feed and the tab.
file: crates/cortex-tui/src/app/state/commands.rs
in: for_clipboard
find: .filter(|&c| matches!(c, '\n' | '\t') || cortex_term::sanitize::visible(c).is_none())
replace: .filter(|_| true)
caught-by:
    app::tests::output::copy_drops_control_characters_and_escapes_what_acts_unseen
    app::tests::output::copy_of_an_answer_of_control_characters_copies_nothing

[break] copy-keeps-what-acts-unseen
rule: `/copy` writes what acts unseen (a bidirectional override, a tag character, a zero-width space) as its escape, as the screen shows it.
file: crates/cortex-tui/src/app/state/commands.rs
in: for_clipboard
find: cortex_term::sanitize(&typed).into_owned()
replace: typed
caught-by:
    app::tests::output::copy_drops_control_characters_and_escapes_what_acts_unseen

[break] the-editor-counts-what-acts-unseen-as-nothing
rule: The editor lays a cluster out in the columns the input box draws it in: what acts unseen in its escape's, so that the cursor stays after the text and no row is cut.
file: crates/cortex-tui/src/editor/cluster.rs
in: width
find: Cow::Owned(shown) => text::width(&shown)
replace: Cow::Owned(_) => text::grapheme_width(cluster)
caught-by:
    view::input::tests::what_acts_unseen_takes_the_columns_of_its_escape

[break] the-editor-counts-a-chip-by-its-raw-label
rule: A chip is laid out as wide as its label is drawn, made safe to show.
file: crates/cortex-tui/src/editor/layout.rs
in: cluster_width
find: chip_width(&cortex_term::sanitize(chip.label()), width)
replace: chip_width(chip.label(), width)
caught-by:
    view::input::tests::a_chip_is_laid_out_as_wide_as_its_label_is_drawn

[break] any-scheme-is-a-link
rule: Only a web address (`http`, `https`) is written as a terminal hyperlink: a `file:` address names a share a click sends credentials to, or a local file the system runs.
file: crates/cortex-term/src/line.rs
in: linkable
find: let web = scheme.eq_ignore_ascii_case("http") || scheme.eq_ignore_ascii_case("https");
replace: let web = !scheme.is_empty();
packages: cortex-term, cortex-tui
caught-by:
    line::tests::only_a_web_address_becomes_a_link
    markdown::tests::a_link_that_is_not_a_web_address_shows_its_address

[break] a-refused-link-hides-its-address
rule: A link that may not be a hyperlink is drawn with its address after its text, though the terminal shows links.
file: crates/cortex-tui/src/markdown/rows.rs
in: Laid::new
find: && !(frame.look.hyperlinks && cortex_term::line::linkable(&url))
replace: && !frame.look.hyperlinks
caught-by:
    markdown::tests::a_link_that_is_not_a_web_address_shows_its_address

[break] a-table-hides-a-links-address
rule: A link in a table's cell is drawn with its address after its text where the terminal shows no links or the address may not be one, as in a paragraph.
file: crates/cortex-tui/src/markdown/table.rs
in: cell
find: if !(frame.look.hyperlinks && cortex_term::line::linkable(url)) && shown != *url {
replace: if false {
caught-by:
    markdown::tests::a_link_that_is_not_a_web_address_shows_its_address

# The review's breaks S1 to S9: removing `sanitize` at a site where only
# control characters were tested, which the renderer shows as symbols
# anyway. Each is now caught by text holding what acts unseen.

[break] approval-summary-unsanitised
rule: An approval's summary is drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/dialog.rs
in: approval
find: sanitize(&request.summary)
replace: std::borrow::Cow::<str>::Borrowed(&request.summary)
caught-by:
    view::dialog::tests::every_field_of_an_approval_escapes_what_acts_unseen

[break] approval-reason-unsanitised
rule: An approval's reasons are drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/dialog.rs
in: approval
find: sanitize(reason)
replace: std::borrow::Cow::<str>::Borrowed(reason.as_str())
caught-by:
    view::dialog::tests::every_field_of_an_approval_escapes_what_acts_unseen

[break] approval-arguments-unsanitised
rule: A tool's arguments in an approval are drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/dialog.rs
in: approval
find: sanitize(&text)
replace: std::borrow::Cow::<str>::Borrowed(text.as_str())
caught-by:
    view::dialog::tests::every_field_of_an_approval_escapes_what_acts_unseen

[break] approval-rule-pattern-unsanitised
rule: The pattern of a rule a lasting answer would add is drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/dialog.rs
in: approval
find: sanitize(&rule.pattern)
replace: rule.pattern
caught-by:
    view::dialog::tests::every_field_of_an_approval_escapes_what_acts_unseen

[break] trust-workspace-unsanitised
rule: The trust question's workspace is drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/dialog.rs
in: trust
find: sanitize(&request.workspace)
replace: std::borrow::Cow::<str>::Borrowed(request.workspace.as_str())
caught-by:
    view::dialog::tests::every_field_of_the_trust_question_escapes_what_acts_unseen

[break] trust-detail-unsanitised
rule: A trust resource's detail is drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/dialog.rs
in: trust
find: sanitize(&resource.detail).into_owned()
replace: resource.detail.clone()
caught-by:
    view::dialog::tests::every_field_of_the_trust_question_escapes_what_acts_unseen

[break] question-text-unsanitised
rule: A question of the core's is drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/dialog.rs
in: title
find: let text = sanitize(text)
replace: let text = std::borrow::Cow::<str>::Borrowed(text)
caught-by:
    view::dialog::tests::a_question_escapes_what_acts_unseen

[break] listing-unsanitised
rule: A command's listing is drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/blocks.rs
in: listing
find: clean(line)
replace: line.clone()
caught-by:
    view::blocks::tests::content_is_sanitised_and_never_too_wide

[break] menu-detail-unsanitised
rule: A menu row's note is drawn with what acts unseen escaped.
file: crates/cortex-tui/src/view/menu.rs
in: rows
find: super::one_line(&row.detail)
replace: row.detail.clone()
caught-by:
    view::menu::tests::a_picker_escapes_what_acts_unseen_in_every_part
