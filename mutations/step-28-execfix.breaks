# Step 28, the fixes to an extension's program from the review of its
# process starts: the look after a program runs git as the program was
# confined, a program decided late is given what is left of the call's
# time, a protected-path change stops the script's call, a question shows
# the program's input, the harness-files check reads Windows' roots, the
# look at protected paths at `unrestricted`, Bash on Windows, and more
# lookalikes (docs/architecture/12-extensions.md; docs/security.md,
# sections 3 and 12).
#
# The breaks marked `os: windows` are judged by the Windows tests; run them
# on a runner with
# `gh workflow run try --ref <branch> -f os=windows -f command="mutate <break>"`.

# ----------------------------------------- the git after a program

[break] the-look-after-a-program-runs-git-at-the-sessions-level
rule: The look at what a program changed runs git as the program was confined: inside the sandbox at every level after one its own launcher confined, so a filter it planted never runs with the user's rights.
file: crates/cineris-core/src/ext/exec.rs
in: run
find: Arc::new(FollowingTheProgram(Arc::clone(&parts.git)))
replace: Arc::clone(&parts.git) as Arc<dyn cineris_base::git::Confinement>
caught-by:
    cineris-core::it ext_exec::confined::sys_the_look_after_a_program_runs_git_confined_at_unrestricted

[break] following-the-program-starts-git-as-the-session-does
rule: The git that follows a confined program is started through the reading launcher whatever the session's level.
file: crates/cineris-core/src/sandbox.rs
in: FollowingTheProgram::start
find: sandbox.start_git_confined(git, arguments)
replace: Ok(sandbox.start_git(git, arguments))
caught-by:
    cineris-core::it ext_exec::confined::sys_the_look_after_a_program_runs_git_confined_at_unrestricted

# ----------------------------------------- the call's time, and its end

[break] a-program-decided-late-is-given-the-time-from-before
rule: A program decided after a person was asked is given no more than what is left of the call's time.
file: crates/cineris-core/src/ext/exec.rs
in: run
find: let timeout = request.timeout.min(left);
replace: let timeout = request.timeout; let _ = left;
caught-by:
    cineris-core::it ext_exec::sys_a_program_decided_late_is_given_only_what_is_left_of_the_calls_time

[break] the-calls-deadline-is-not-its-time
rule: A call's deadline is its start on the session's clock and the manifest's time.
file: crates/cineris-core/src/ext/tools.rs
in: LoadedExtension::call_tool
find: .saturating_add(self.approved.manifest.limits.time);
replace: .saturating_add(self.approved.manifest.limits.time.saturating_mul(2));
caught-by:
    cineris-core::it ext_exec::sys_a_program_decided_late_is_given_only_what_is_left_of_the_calls_time

[break] a-run-ended-early-is-not-looked-at
rule: What a program did is looked at whatever ended its run: its own time, the call's cancellation, or a start that failed once the process was made.
file: crates/cineris-core/src/ext/exec.rs
in: run
find: (Some(watch), Some(before)) => look_after(parts, host, watch, before, escaped).await,
replace: (Some(watch), Some(before)) if ran.as_ref().is_ok_and(|finished| finished.ending == Ending::Exited) => look_after(parts, host, watch, before, escaped).await,
caught-by:
    cineris-core::it ext_exec::confined::sys_a_program_stopped_at_its_time_is_still_looked_at

# ----------------------------------------- a stop ends the script's call

[break] a-protected-change-is-a-failure-the-script-catches
rule: A protected path a program changed stops the script's call, not only the turn: a script that catches the error does not go on.
file: crates/cineris-core/src/ext/exec.rs
in: look_after
find: host.parts.policy.stop_turn(cx.turn, note.clone()); return Err(HostError::Stopped(note));
replace: host.parts.policy.stop_turn(cx.turn, note.clone()); return Err(HostError::Failed(note));
caught-by:
    cineris-core::it ext_exec::confined::sys_a_script_that_catches_a_protected_change_does_not_go_on
    cineris-core::it ext_exec::confined::sys_a_program_that_writes_a_protected_path_fails_and_stops_the_turn

[break] a-change-from-outside-is-a-refusal-the-script-catches
rule: A protected path changed from outside since the last look stops the script's call before its program starts.
file: crates/cineris-core/src/ext/exec.rs
in: run
find: return Err(HostError::Stopped(format!(
replace: return Err(HostError::Denied(format!(
caught-by:
    cineris-core::it ext_exec::confined::sys_a_protected_path_changed_since_the_last_program_refuses_the_next

# ----------------------------------------- the program's input, shown

[break] a-programs-input-is-not-shown
rule: A question about a program given input shows how long it is and how it begins: the engine does not judge it.
file: crates/cineris-core/src/ext/exec.rs
in: run
find: extra: request.stdin.as_deref().map(input_reason)
replace: extra: { let _ = input_reason; None }
caught-by:
    cineris-core::it ext_exec::a_question_about_a_program_given_input_shows_how_the_input_begins

[break] a-host-calls-reason-is-not-put
rule: A host call's own reason is put to the person after the engine's.
file: crates/cineris-core/src/policy.rs
in: EnginePolicy::ask_with
find: .chain(host.as_ref().and_then(|host| host.extra.clone()))
replace: .chain(None::<String>)
caught-by:
    cineris-core::it ext_exec::a_question_about_a_program_given_input_shows_how_the_input_begins

[break] a-programs-input-is-shown-past-three-lines
rule: A question shows at most three lines of a program's input.
file: crates/cineris-core/src/ext/exec.rs
in: input_reason
find: .take(INPUT_SHOWN_LINES)
replace: .take(INPUT_SHOWN_LINES + 1)
caught-by:
    cineris-core::it ext_exec::a_question_about_a_program_given_input_shows_how_the_input_begins

[break] a-programs-input-is-shown-unescaped
rule: A program's input is shown with every character that acts unseen escaped.
file: crates/cineris-core/src/ext/exec.rs
in: input_reason
find: cineris_base::visible(start)
replace: start
caught-by:
    cineris-core::it ext_exec::a_question_about_a_program_given_input_shows_how_the_input_begins

# ----------------------------------------- the harness's files, on Windows

[break] a-root-that-cannot-be-read-is-passed-over
rule: A write root that cannot be read as an absolute path counts as holding the harness's files.
file: crates/cineris-core/src/assemble.rs
in: holds_harness_files
find: Err(_) => true
replace: Err(_) => false
caught-by:
    cineris-core assemble::harness_files_tests::a_root_that_cannot_be_read_counts_as_holding_the_harness_files

[break] the-roots-are-judged-in-the-file-systems-form
rule: An extension's write roots are judged in their plain form, which the judgement can read on Windows.
file: crates/cineris-core/src/ext/exec.rs
in: run
find: .map(cineris_base::path::AbsPath::to_native_string)
replace: .map(|root| root.to_fs_path().to_string_lossy().into_owned())
os: windows
caught-by:
    cineris-core::it ext_exec::sys_a_write_root_that_holds_the_harness_files_runs_nothing

# ----------------------------------------- the look at protected paths

[break] the-look-around-a-program-follows-the-sessions-level
rule: The protected paths are looked at around a program with a write root wherever the sandbox enforces, at every level, as its launcher confines it at every level.
file: crates/cineris-core/src/sandbox.rs
in: SessionSandbox::extension_watch
find: self.watch.as_ref()
replace: self.watch()
caught-by:
    cineris-core::it ext_exec::confined::sys_a_program_that_writes_a_protected_path_fails_and_stops_the_turn

# ----------------------------------------- Bash on Windows

[break] bash-on-windows-is-taken-as-the-program
rule: On Windows a program the session's shell calls read-only is asked about, whatever the shell: Windows' lookup finds the program, not the shell's.
file: crates/cineris-core/src/ext/exec.rs
in: run
find: read_only_asks: cfg!(windows)
replace: read_only_asks: false
os: windows
caught-by:
    cineris-core::it ext_exec::windows::sys_in_bash_on_windows_a_program_the_shell_calls_read_only_is_asked_about

# ----------------------------------------- more lookalikes

[break] lookalike-modifier-double-prime-taken
rule: An argument with a modifier letter double prime (U+02BA) is refused: best fit makes it a double quote.
file: crates/cineris-core/src/programs.rs
in: LOOKALIKES
find: '\u{02BA}'
replace: '\u{1}'
caught-by:
    cineris-core programs::tests::a_lookalike_of_a_quote_or_a_backslash_is_refused_on_every_system

[break] lookalike-set-minus-taken
rule: An argument with a set minus (U+2216) is refused: best fit makes it a backslash.
file: crates/cineris-core/src/programs.rs
in: LOOKALIKES
find: '\u{2216}'
replace: '\u{1}'
caught-by:
    cineris-core programs::tests::a_lookalike_of_a_quote_or_a_backslash_is_refused_on_every_system

[break] lookalike-soft-hyphen-taken
rule: An argument with a soft hyphen (U+00AD) is refused: best fit makes it a hyphen.
file: crates/cineris-core/src/programs.rs
in: LOOKALIKES
find: '\u{AD}'
replace: '\u{1}'
caught-by:
    cineris-core programs::tests::a_lookalike_of_a_quote_or_a_backslash_is_refused_on_every_system

[break] lookalike-fullwidth-hyphen-taken
rule: An argument with a fullwidth hyphen-minus (U+FF0D) is refused: best fit makes it a hyphen.
file: crates/cineris-core/src/programs.rs
in: LOOKALIKES
find: '\u{FF0D}'
replace: '\u{1}'
caught-by:
    cineris-core programs::tests::a_lookalike_of_a_quote_or_a_backslash_is_refused_on_every_system
