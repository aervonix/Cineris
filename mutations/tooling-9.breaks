# try: a dispatched run's id, and a run whose status lags its jobs (item 4).

[break] try-result-reads-a-run-with-a-job-still-running-as-finished
rule: A run is read as finished when every job has ended, and not before.
file: xtask/src/try_result.rs
in: every_job_ended
find: status.jobs.iter().all(|job| job.conclusion.is_some())
replace: status.jobs.iter().any(|job| job.conclusion.is_some())
caught-by:
    try_result::tests::a_run_whose_jobs_have_all_ended_is_finished_whatever_its_status_says

[break] try-dispatch-drops-the-against-input
rule: A dispatch passes each input that is set.
file: xtask/src/try_run.rs
in: dispatch_arguments
find: field("against", against.clone());
replace: let _ = against;
caught-by:
    try_run::tests::a_dispatch_passes_each_input_that_is_set_and_no_other

[break] try-dispatch-takes-an-old-run-for-its-own
rule: The run a dispatch made is one that was not listed before it.
file: xtask/src/try_run.rs
in: new_runs
find: .filter(|run| !before.contains(run))
replace: .filter(|_| true)
caught-by:
    try_run::tests::the_run_a_dispatch_made_is_the_one_not_listed_before_it

# Typed outcomes in the core rig's results (item 3).

[break] rig-an-outcome-takes-any-text
rule: A tool's outcome compared with a name no outcome has fails the test.
file: crates/cortex-core/tests/it/main.rs
in: Outcome::known
find: cortex_protocol::item::ToolOutcome::KNOWN.contains(&text)
replace: true || cortex_protocol::item::ToolOutcome::KNOWN.contains(&text)
caught-by:
    cortex-core::it approvals::a_tool_outcome_compared_with_a_name_no_outcome_has_fails_the_test

# The time-limit test under load (outstanding: a-time-limit-test-under-load).

[break] process-a-call-has-no-time-limit
rule: A command's call arms its time limit when it starts.
file: crates/cortex-tools/src/process/mod.rs
in: run_until
find: timeout: Some(self.timer.sleep(start.timeout))
replace: timeout: None
caught-by:
    cortex-tools::it process::sys_a_time_limit_stops_the_whole_tree

