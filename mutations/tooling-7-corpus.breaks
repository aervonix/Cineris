# The seventh tooling step, the corpus of real code: `cargo xtask corpus`,
# `cortex_testkit::corpus` and the fetch that `try`'s `perf -p CRATE` makes.
# Written with the code, and run with `cargo xtask mutate tooling-7-corpus`.

# ----------------------------------------------------------------- the hash

[break] corpus-hash-ignores-the-content
rule: The hash is of every file's content: a changed byte changes it.
file: crates/cortex-testkit/src/corpus/shared.rs
in: measure
find: hash.write(&content);
replace: let _ = &content;
caught-by:
    cortex-testkit corpus::tests::a_changed_byte_is_refused
    cortex-testkit corpus::tests::the_hash_is_fnv_1a_of_the_paths_lengths_and_contents_in_path_order

[break] corpus-hash-ignores-the-path
rule: The hash is of every file's path: the same bytes under another name are another corpus.
file: crates/cortex-testkit/src/corpus/shared.rs
in: measure
find: hash.write(relative.as_bytes());
replace: let _ = relative;
caught-by:
    cortex-testkit corpus::tests::a_file_under_another_name_is_refused
    cortex-testkit corpus::tests::the_hash_is_fnv_1a_of_the_paths_lengths_and_contents_in_path_order

[break] corpus-listing-is-not-sorted
rule: The files are hashed in the byte order of their paths, the same on every system.
file: crates/cortex-testkit/src/corpus/shared.rs
in: list
find: files.sort_unstable();
replace: files.reverse();
caught-by:
    cortex-testkit corpus::tests::the_listing_is_in_the_byte_order_of_the_paths_whatever_the_folder_says
    cortex-testkit corpus::tests::the_hash_is_fnv_1a_of_the_paths_lengths_and_contents_in_path_order

[break] corpus-path-separator-is-the-systems
rule: A file's path in the hash is written with `/` on every system, or the same corpus would hash differently on Windows.
file: crates/cortex-testkit/src/corpus/shared.rs
in: list
find: format!("{prefix}/{name}")
replace: format!("{prefix}{name}")
caught-by:
    cortex-testkit corpus::tests::the_hash_is_fnv_1a_of_the_paths_lengths_and_contents_in_path_order

[break] corpus-link-is-followed-as-a-file
rule: A link is not a file of the corpus: it is refused, not followed.
file: crates/cortex-testkit/src/corpus/shared.rs
in: list
find: } else if kind.is_file() {
replace: } else if !kind.is_dir() {
caught-by:
    cortex-testkit corpus::tests::a_link_is_not_followed

# ------------------------------------------------------------- verification

[break] corpus-verify-accepts-any-hash
rule: A corpus whose hash is not the pin's is refused: a changed byte of the same length, or a file renamed.
file: crates/cortex-testkit/src/corpus/shared.rs
in: verify
find: if found.hash != pin.hash {
replace: if false {
caught-by:
