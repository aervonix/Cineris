[break] corpus-folder-name-is-not-sixteen-digits
rule: The corpus's folder is named by its hash in sixteen hexadecimal digits.
file: crates/cortex-testkit/src/corpus/shared.rs
in: Pin::name
find: format!("{:016x}", self.hash)
replace: format!("{:x}", self.hash)
caught-by:
    cortex-testkit corpus::tests::the_folder_of_a_corpus_is_named_by_its_hash

# ----------------------------------------------------- where it is kept

