# ------------------------------------------------------------------ fetching

[break] corpus-copies-more-than-rust
rule: Only the `.rs` files of a crate are copied into the corpus.
file: xtask/src/corpus.rs
in: copy_rust_files
find: entry.path().extension().is_some_and(|ext| ext == "rs")
replace: entry.path().extension().is_some()
caught-by:
    corpus::tests::only_rust_files_are_copied_byte_for_byte_and_dated

[break] corpus-copy-changes-a-byte
rule: A file is copied byte for byte, line endings included.
file: xtask/src/corpus.rs
in: copy_rust_files
find: file.write_all(&content)
replace: file.write_all(&content[..content.len() - 1])
caught-by:
    corpus::tests::only_rust_files_are_copied_byte_for_byte_and_dated

[break] corpus-copy-keeps-no-date
rule: Every file of the corpus has the same old date, so that a freshly fetched tree is not one modified a moment ago.
file: xtask/src/corpus.rs
in: copy_rust_files
find: .and_then(|()| file.set_modified(date))
replace: .and_then(|()| Ok::<(), std::io::Error>(()))
caught-by:
    corpus::tests::only_rust_files_are_copied_byte_for_byte_and_dated

[break] corpus-lock-takes-a-package-from-a-repository
rule: The corpus is crates from a registry, at checksums: a package from a repository is refused.
file: xtask/src/corpus.rs
in: registry_packages
find: if !(source.starts_with("registry+") || source.starts_with("sparse+")) {
replace: if false {
caught-by:
    corpus::tests::the_lock_gives_each_registry_crate_and_refuses_one_from_elsewhere

