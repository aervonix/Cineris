# Step 27: the changes to `cortex-core` the RPC server needs, each on a
# commit of its own (docs/steps/27/answered.md, "What changes outside
# cortex-rpc and cortex-cli"). The rules broken one at a time, with the
# tests that must fail.

# ------------------------------------------------- sessions kept running

[break] a-kept-session-ends-with-its-client
rule: With `keep_sessions`, a disconnect ends no session: it goes on with no client.
file: crates/cortex-core/src/core.rs
in: disconnect
find: if live.sink.unsubscribe(client.0) && !keep && live.sink.subscribers().is_empty() {
replace: if live.sink.unsubscribe(client.0) && live.sink.subscribers().is_empty() {
caught-by:
    cortex-core::it lifecycle::with_keep_sessions_a_session_runs_on_when_its_client_goes

[break] a-question-with-no-client-is-refused-at-once
rule: With `keep_sessions`, an approval in a session with no client at all waits for a `user` client to open it.
file: crates/cortex-core/src/policy.rs
in: ask
find: let waits = self.waits_for_a_client && subscribers.is_empty();
replace: let waits = false;
caught-by:
    cortex-core::it lifecycle::with_keep_sessions_a_question_with_no_client_waits_for_a_user_to_open_the_session
    cortex-core::it lifecycle::with_keep_sessions_a_question_with_no_client_is_denied_at_its_time_limit

[break] a-client-that-answers-no-approvals-makes-a-question-wait
rule: With `keep_sessions`, a session whose clients are there and answer no approvals still gets the default at once.
file: crates/cortex-core/src/policy.rs
in: ask
find: let waits = self.waits_for_a_client && subscribers.is_empty();
replace: let waits = self.waits_for_a_client;
caught-by:
    cortex-core::it lifecycle::with_keep_sessions_a_client_that_answers_no_approvals_still_gets_the_default

[break] a-session-put-together-for-a-client-that-left-is-kept
rule: With `keep_sessions`, a session put together for a client that left meanwhile is still ended.
file: crates/cortex-core/src/core.rs
in: still_wanted
find: let kept = self.inner.options.keep_sessions && !put_together;
replace: let kept = self.inner.options.keep_sessions;
caught-by:
    cortex-core::it lifecycle::with_keep_sessions_a_session_started_for_a_client_that_left_does_not_run_on

# ------------------------------------------- the queue bounded by bytes

[break] the-queue-is-never-full-of-bytes
rule: A client's queue is full once the deltas it holds reach its byte bound, merged ones counted whole.
file: crates/cortex-core/src/events.rs
in: EventQueue::push
find: let full_of_bytes = state.delta_bytes >= self.delta_bytes;
replace: let full_of_bytes = false;
caught-by:
    cortex-core events::tests::a_stopped_reader_holds_a_bounded_number_of_bytes_of_one_long_item
    cortex-core::it events::a_reader_that_stops_during_one_long_item_holds_bounded_bytes_and_one_resync

[break] a-merged-delta-is-not-counted
rule: The bytes of a delta merged into the one before it count towards the bound.
file: crates/cortex-core/src/events.rs
in: EventQueue::push
find:
                    *delta_bytes += size;
                    return;
replace:
                    return;
caught-by:
    cortex-core events::tests::a_stopped_reader_holds_a_bounded_number_of_bytes_of_one_long_item
    cortex-core::it events::a_reader_that_stops_during_one_long_item_holds_bounded_bytes_and_one_resync

[break] the-bytes-taken-are-not-given-back
rule: The bytes of a delta the reader takes are no longer held, so a reader that keeps up is never full of them.
file: crates/cortex-core/src/events.rs
in: EventQueue::try_next
find: state.delta_bytes = state.delta_bytes.saturating_sub(delta_size(&delta.delta));
replace: let _ = delta_size(&delta.delta);
caught-by:
    cortex-core events::tests::the_bytes_held_go_down_as_the_reader_takes_deltas
    cortex-core events::tests::a_stopped_reader_holds_a_bounded_number_of_bytes_of_one_long_item

[break] a-whole-event-is-dropped-past-the-bytes
rule: Whole events are never dropped, past the byte bound as past the count.
file: crates/cortex-core/src/events.rs
in: EventQueue::push
find:
        if let Event::ItemDelta(delta) = &event.event {
            state.delta_bytes += delta_size(&delta.delta);
        }
replace:
        if let Event::ItemDelta(delta) = &event.event {
            state.delta_bytes += delta_size(&delta.delta);
        } else if state.delta_bytes >= self.delta_bytes {
            return;
        }
caught-by:
    cortex-core events::tests::a_stopped_reader_holds_a_bounded_number_of_bytes_of_one_long_item
    cortex-core::it events::a_reader_that_stops_during_one_long_item_holds_bounded_bytes_and_one_resync
