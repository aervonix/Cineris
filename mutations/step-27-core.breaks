rule: A grant whose engine cannot be made covers nothing, and the supervisor is told so, with why.
file: crates/cortex-core/src/policy.rs
in: grant_engine
find: let engine = Engine::start(parts)
replace: let engine = Engine::start(parts).or_else(|_| Engine::start(template.clone()))
caught-by:
    cortex-core policy::tests::a_grant_whose_engine_cannot_be_made_covers_nothing_and_says_why

[break] a-guided-grant-is-taken-as-guided
rule: A grant at `guided`, which is not there yet, is read as `supervised`.
file: crates/cortex-core/src/policy.rs
in: grant_level
find: let level = if level == Level::Guided {
replace: let level = if level == Level::Guided && false {
caught-by:
    cortex-core policy::tests::a_guided_grant_is_read_as_supervised

[break] a-scope-is-compared-by-its-text
rule: Two scopes are the same when each holds the other, however their roots are spelled or split.
file: crates/cortex-core/src/policy.rs
in: same_scope
find: let same = |a: &PathSet, b: &PathSet| within(a, b) && within(b, a);
replace: let same = |a: &PathSet, b: &PathSet| a.all == b.all && a.roots == b.roots;
caught-by:
    cortex-core policy::tests::a_scope_is_compared_by_what_it_holds

[break] what-applies-unconfined-is-not-said
rule: The notice of a grant's limits says which of its allow rules do apply where commands are not confined: those of tools and hosts.
file: crates/cortex-core/src/policy.rs
in: limits_in
find: let others = allows(&[EffectKind::Ext, EffectKind::Network]);
replace: let others: Vec<String> = Vec::new();
caught-by:
    cortex-core policy::tests::the_supervisor_is_told_what_of_its_grant_applies_unconfined
