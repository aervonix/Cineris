replace: if self.dispatcher.is_none() && method == "initialize" {
caught-by:
    cortex-rpc::it wire::nothing_is_taken_before_initialize_and_initialize_is_taken_once

[break] initialize-is-taken-twice
rule: A second `initialize` on a connection is refused `already_initialized`.
file: crates/cortex-rpc/src/connection.rs
in: request
find:
            Op::Initialize(_) => self.refused(self.shared.refuse_with(
                id,
                ErrorKind::Usage,
                code::ALREADY_INITIALIZED,
                "This connection has said `initialize` already.",
            )),
replace:
            Op::Initialize(params) => self.initialize(id, Some(serde_json::to_value(params).unwrap_or_default())).await,
caught-by:
    cortex-rpc::it wire::nothing_is_taken_before_initialize_and_initialize_is_taken_once

[break] a-refused-initialize-leaves-its-client-connected
rule: A refused `initialize` disconnects the client it made, and the connection may say `initialize` again.
file: crates/cortex-rpc/src/connection.rs
in: initialize
find:
            Err(error) => {
                core.disconnect(client.id).await;
replace:
            Err(error) => {
                *lock(&self.shared.client) = Some(client.clone());
                self.dispatcher = Some(Dispatcher::start(Arc::new(|_| Box::pin(async { Err(Box::new(ErrorData::new(ErrorKind::Usage, "x", "x"))) })), Arc::new(|_, _| {})));
caught-by:
    cortex-rpc::it wire::nothing_is_taken_before_initialize_and_initialize_is_taken_once

[break] an-answer-to-a-request-is-not-recorded
rule: A request put to the client is remembered with its method, so the client's answer is read against it and reaches the core.
file: crates/cortex-rpc/src/connection.rs
in: write
find: lock(&shared.asked).insert(id.clone(), request.method());
replace: let _ = request.method();
caught-by:
    cortex-rpc::it conformance::every_scenario_is_the_same_in_process_and_over_the_wire

[break] an-event-is-written-as-another-method
rule: An event is a `session/event` notification.
