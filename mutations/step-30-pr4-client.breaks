# Step 30, part 4: our own MCP client over standard I/O, both eras
# (docs/steps/30/parts/pr4-client.md). Each rule of the client, broken one
# at a time, with the test that must catch it. Some breaks make a test wait
# for what never comes, which the runner's time limit then fails.

# JSON-RPC and the correlator.

[break] a-string-echo-of-an-id-is-not-matched
rule: An answer whose id is our integer written as a string of its digits is matched to its request.
file: crates/cineris-mcp/src/jsonrpc.rs
in: RequestId::ours
find: (number.to_string() == *text).then_some(number)
replace: None
caught-by:
    cineris-mcp jsonrpc::tests::our_ids_are_matched_as_numbers_or_their_digits
    cineris-mcp::it calls::an_answer_with_the_id_written_as_a_string_of_its_digits_is_matched

[break] a-request-given-up-is-kept-waiting
rule: A request given up (cancelled, past its limit) is forgotten, so that its late answer is a stray.
file: crates/cineris-mcp/src/transport.rs
in: Waiting::drop
find: self.pending.remove(self.id);
replace:
caught-by:
    cineris-mcp transport::tests::a_request_given_up_takes_no_answer_and_the_end_reaches_every_waiter

[break] requests-in-flight-are-unbounded
rule: At most `max_in_flight` requests wait for their answers at once; more wait for room.
file: crates/cineris-mcp/src/session.rs
in: Rpc::new
find: room: Semaphore::new(in_flight.max(1))
replace: room: Semaphore::new(Semaphore::MAX_PERMITS)
caught-by:
    cineris-mcp::it calls::only_so_many_requests_wait_for_their_answers_at_once

[break] a-request-given-up-is-not-cancelled
rule: A request cancelled, or past its limit, is cancelled on the server with `notifications/cancelled` naming it.
file: crates/cineris-mcp/src/session.rs
in: Rpc::ask
find: if cancels && sent.load(Ordering::Relaxed) {
replace: if false {
caught-by:
    cineris-mcp::it calls::a_cancelled_call_returns_at_once_and_its_late_answer_is_ignored
    cineris-mcp::it calls::a_call_past_its_limit_is_cancelled_and_says_it_timed_out
    cineris-mcp::it calls::a_listing_past_its_limit_is_cancelled_and_says_it_timed_out

[break] a-batch-is-read-from-any-server
rule: Only a `2025-03-26` server may send a batch; another's is counted and not read.
file: crates/cineris-mcp/src/stdio.rs
in: StdioTransport::agreed
find: era == Era::Legacy && version == BATCH_REVISION
replace: true
caught-by:
    cineris-mcp::it calls::a_batch_is_read_only_from_a_server_of_the_revision_that_has_them

[break] a-batch-is-read-from-no-server
rule: A `2025-03-26` server's batch is read, each message in it.
file: crates/cineris-mcp/src/stdio.rs
in: StdioTransport::take
find: Decoded::Batch(messages) if self.batches.load(Ordering::Acquire) =>
replace: Decoded::Batch(messages) if false =>
caught-by:
    cineris-mcp::it calls::a_batch_is_read_only_from_a_server_of_the_revision_that_has_them

# The allowance: every message that answers nothing is counted.

[break] messages-that-answer-nothing-are-not-counted
rule: Every message that is not the answer to a pending request (a notification, a server's request, a stray or duplicate answer) is counted with its bytes.
file: crates/cineris-mcp/src/stdio.rs
in: StdioTransport::route
find: budget.spend(bytes).map_err(ClientError::Protocol)?;
replace:
caught-by:
    cineris-mcp::it flood::a_server_that_sends_notices_in_a_loop_is_stopped_and_another_server_goes_on
    cineris-mcp::it flood::every_kind_of_message_that_answers_nothing_counts
    cineris-mcp::it flood::the_allowance_is_a_minutes

[break] what-is-not-a-message-is-not-counted
rule: A line that is not a message, and a batch a server may not send, are counted with their bytes.
file: crates/cineris-mcp/src/stdio.rs
in: StdioTransport::take
find: Decoded::Batch(_) | Decoded::Malformed => budget.spend(line.len()).map_err(misbehaving)
replace: Decoded::Batch(_) | Decoded::Malformed => Ok(())
caught-by:
    cineris-mcp::it flood::every_kind_of_message_that_answers_nothing_counts

[break] the-allowance-is-never-renewed
rule: The allowance is a minute's: the counts start again when the window ends.
file: crates/cineris-mcp/src/stdio.rs
in: read
find: budget.reset();
replace:
caught-by:
    cineris-mcp::it flood::the_allowance_is_a_minutes

[break] the-allowance-of-messages-is-doubled
rule: Past 1,000 messages that answer nothing in a minute, the server is stopped as misbehaving.
file: crates/cineris-mcp/src/transport.rs
in: Budget::spend
find: if self.messages > MESSAGES_A_MINUTE {
replace: if self.messages > MESSAGES_A_MINUTE * 2 {
caught-by:
    cineris-mcp transport::tests::the_budget_ends_at_one_message_too_many_or_one_byte_too_many
    cineris-mcp::it flood::a_server_that_sends_notices_in_a_loop_is_stopped_and_another_server_goes_on
    cineris-mcp::it flood::the_allowance_is_a_minutes

[break] the-allowance-of-bytes-is-gone
rule: Past 16 MiB of messages that answer nothing in a minute, the server is stopped as misbehaving.
file: crates/cineris-mcp/src/transport.rs
in: Budget::spend
find: if self.bytes > BYTES_A_MINUTE {
replace: if false {
caught-by:
    cineris-mcp transport::tests::the_budget_ends_at_one_message_too_many_or_one_byte_too_many
    cineris-mcp::it flood::sixteen_mib_of_notices_in_a_minute_is_too_much

[break] a-misbehaving-server-is-left-running
rule: A server stopped as misbehaving has its input closed and its process ended.
file: crates/cineris-mcp/src/stdio.rs
in: read
find: if misbehaved {
replace: if false {
caught-by:
    cineris-mcp::it flood::a_server_that_sends_notices_in_a_loop_is_stopped_and_another_server_goes_on

# The probe and the eras.

[break] the-probe-is-cancelled
rule: The probe is never cancelled: a legacy server would not know the request it named.
file: crates/cineris-mcp/src/session.rs
in: discover
find: Some(limit), None, false
replace: Some(limit), None, true
caught-by:
    cineris-mcp::it probe::a_silent_server_is_taken_as_legacy_after_the_probes_time_and_a_late_answer_is_ignored

[break] the-fallback-is-keyed-to-one-error
rule: Any error to the probe but the modern ones is a legacy server; the fallback is not keyed to one code.
file: crates/cineris-mcp/src/session.rs
in: discover
find: _ => Probe::Legacy
replace: -32601 => Probe::Legacy, _ => Probe::Refused(String::new())
caught-by:
    cineris-mcp::it probe::a_legacy_server_that_refuses_the_probe_with_any_error_is_initialized_on_the_same_process

[break] a-modern-error-falls-back-to-initialize
rule: `-32021` (and `-32020`, `-32022`) to the probe is a modern server, never sent `initialize`.
file: crates/cineris-mcp/src/session.rs
in: discover
find: wire::MISSING_CLIENT_CAPABILITY =>
replace: -1 =>
caught-by:
    cineris-mcp::it probe::the_other_modern_errors_end_the_start_without_initialize

[break] an-unsupported-revision-is-not-asked-again
rule: After `-32022`, the server is asked once more with a revision from its list.
file: crates/cineris-mcp/src/connect.rs
in: Start::agree
find: Probe::Unsupported(supported) => return self.retry(link, &supported).await,
replace: Probe::Unsupported(_) => return Err(ClientError::NotStarted(String::new())),
caught-by:
    cineris-mcp::it probe::a_server_that_does_not_speak_the_revision_asked_for_is_asked_once_more_with_one_it_does

[break] a-server-that-exits-on-the-probe-is-not-started-again
rule: A server that exits during the probe is started again and sent `initialize` alone.
file: crates/cineris-mcp/src/connect.rs
in: Start::agree
find: Probe::Exited(_) if !started_again => {
replace: Probe::Exited(_) if false => {
caught-by:
    cineris-mcp::it probe::a_server_that_exits_on_the_probe_is_started_again_and_only_initialized

[break] a-server-that-exits-after-answering-the-probe-is-not-started-again
rule: A server that answers the probe and then exits is started again once and sent `initialize`.
file: crates/cineris-mcp/src/connect.rs
in: Start::agree
find: Err(Declined::Stopped(_)) if !started_again => {
replace: Err(Declined::Stopped(_)) if false => {
caught-by:
    cineris-mcp::it probe::a_server_that_refuses_the_probe_and_then_exits_is_started_again

[break] an-unknown-legacy-revision-is-accepted
rule: A legacy server's answer to `initialize` is taken only if it is a revision the client speaks; else the start ends with why.
file: crates/cineris-mcp/src/session.rs
in: initialize
find: if !wire::LEGACY_VERSIONS.contains(&version) {
replace: if false {
caught-by:
    cineris-mcp::it probe::a_legacy_answer_of_a_revision_the_client_does_not_speak_ends_the_start

[break] the-start-limit-begins-after-the-probe
rule: The whole start, the probe included, is held to the definition's start limit.
file: crates/cineris-mcp/src/connect.rs
in: StdioClient::start
find: Limit::new(&timer, "start", definition.start_timeout)
replace: Limit::new(&timer, "start", definition.start_timeout + options.probe_timeout)
caught-by:
    cineris-mcp::it probe::a_silent_server_still_starts_within_the_start_limit_and_initialize_is_never_cancelled

# Legacy servers' requests.

[break] a-ping-is-not-answered
rule: A legacy server's `ping` is answered with `{}` at any time, the handshake included.
file: crates/cineris-mcp/src/session.rs
in: Router::handle
find: Some(if method == "ping" {
replace: Some(if method == "pong" {
caught-by:
    cineris-mcp::it legacy::a_ping_is_answered_during_the_handshake_and_after_it

[break] a-modern-servers-request-is-answered
rule: A modern server sends no requests: one is a fault, counted and never answered.
file: crates/cineris-mcp/src/session.rs
in: Router::handle
find: if self.era() == Some(Era::Modern) {
replace: if false {
caught-by:
    cineris-mcp::it modern::a_modern_servers_request_is_a_fault_counted_and_never_answered

# Listings.

[break] a-listing-that-ended-is-shared
rule: A listing is shared only with who asked while it ran; who asks after it ends gets a new one.
file: crates/cineris-mcp/src/session.rs
in: Session::list_tools
find: && last.number > arrived
replace:
caught-by:
    cineris-mcp::it legacy::listings_asked_for_while_one_runs_share_it

[break] a-listing-is-shared-across-a-change
rule: A listing begun before a change is not shared with who asks after the change.
file: crates/cineris-mcp/src/session.rs
in: Session::list_tools
find: && last.generation == generation
replace:
caught-by:
    cineris-mcp::it legacy::a_change_during_a_listing_makes_who_asks_after_it_list_again

[break] a-listings-lifetime-ends-unseen
rule: The end of a listing's lifetime (`ttlMs`) bumps the changes.
file: crates/cineris-mcp/src/session.rs
in: Session::keep_for
find: router.bump();
replace:
caught-by:
    cineris-mcp::it modern::the_end_of_a_listings_lifetime_bumps_the_changes

[break] a-lifetime-of-zero-bumps-at-once
rule: A lifetime of zero, less, or none bumps nothing, or such a server would be listed without end.
file: crates/cineris-mcp/src/session.rs
in: Session::keep_for
find: (!lifetime.is_zero())
replace: (true)
caught-by:
    cineris-mcp::it modern::a_lifetime_of_zero_or_less_or_none_bumps_nothing

[break] the-cap-on-tools-is-gone
rule: A server offers at most 512 tools; a listing of more is refused.
file: crates/cineris-mcp/src/session.rs
in: Session::list_pages
find: if tools.len() + page.tools.len() > MAX_TOOLS {
replace: if false {
caught-by:
    cineris-mcp::it modern::a_listing_past_twenty_pages_or_past_512_tools_is_refused

[break] the-cap-on-pages-is-one-more
rule: A listing is at most 20 pages.
file: crates/cineris-mcp/src/session.rs
in: Session::list_pages
find: for _ in 0..MAX_PAGES {
replace: for _ in 0..=MAX_PAGES {
caught-by:
    cineris-mcp::it modern::a_listing_past_twenty_pages_or_past_512_tools_is_refused

# Calls.

[break] a-call-is-sent-again-one-round-too-few
rule: A modern server that asks for the call again with only a state is sent it at most three more times.
file: crates/cineris-mcp/src/session.rs
in: Session::call
find: for _ in 0..=MAX_ROUNDS {
replace: for _ in 0..MAX_ROUNDS {
caught-by:
    cineris-mcp::it modern::a_server_that_keeps_asking_for_the_call_again_is_refused_after_three_rounds

[break] input-the-client-never-offered-is-given-a-round
rule: A server that asks for input the client never declared is refused at once.
file: crates/cineris-mcp/src/session.rs
in: Session::call
find: if asks {
replace: if false {
caught-by:
    cineris-mcp::it modern::a_server_that_asks_for_input_the_client_never_offered_or_gives_no_state_is_refused

[break] a-result-of-an-unknown-type-is-complete
rule: A result of a type the client does not know is a fault, not a complete result.
file: crates/cineris-mcp/src/wire.rs
in: result_type
find: Some(Json::String(kind)) if kind == "complete" => Ok(ResultType::Complete),
replace: Some(Json::String(kind)) if kind != "input_required" => Ok(ResultType::Complete),
caught-by:
    cineris-mcp wire::tests::a_result_of_an_unknown_type_is_a_fault_and_an_absent_one_is_complete
    cineris-mcp::it modern::a_result_of_a_type_the_client_does_not_know_is_refused

[break] a-legacy-structured-result-may-be-any-value
rule: A legacy server's structured result is kept only when it is an object.
file: crates/cineris-mcp/src/wire.rs
in: call_output
find: Era::Legacy => value.is_object()
replace: Era::Legacy => !value.is_null()
caught-by:
    cineris-mcp wire::tests::a_legacy_structured_result_is_kept_only_when_it_is_an_object

[break] base64-data-is-measured-by-its-text
rule: An image's, audio's or blob's size is what its base64 decodes to, counted without decoding.
file: crates/cineris-mcp/src/wire.rs
in: decoded_size
find: characters.saturating_mul(3) / 4
replace: data.len()
caught-by:
    cineris-mcp wire::tests::content_is_read_with_data_counted_and_not_kept

[break] a-tool-that-runs-only-as-a-task-is-usable
rule: A tool that runs only as a task (`execution.taskSupport: "required"`) is said to be unusable.
file: crates/cineris-mcp/src/wire.rs
in: ToolDefinition::unusable
find: == Some("required")
replace: == Some("never")
caught-by:
    cineris-mcp wire::tests::a_tool_that_runs_only_as_a_task_or_has_no_object_schema_is_unusable
    cineris-mcp::it legacy::a_tool_that_runs_only_as_a_task_is_listed_as_sent_and_said_to_be_unusable

# The change stream.

[break] a-change-notice-from-any-stream-is-taken
rule: A modern server's change notice bumps the changes only on the open, acknowledged stream it names.
file: crates/cineris-mcp/src/session.rs
in: Router::notified
find: if self.on_stream(params) && self.listen_acked() {
replace: if self.listen_acked() {
caught-by:
    cineris-mcp::it modern::the_change_stream_is_acknowledged_and_only_its_own_notices_bump_the_changes

[break] changes-missed-while-no-stream-was-open-are-not-bumped
rule: A stream opened again after the server ended one bumps the changes when acknowledged: what changed in between was missed.
file: crates/cineris-mcp/src/session.rs
in: Router::notified
find: missed = honoured && listen.reopened;
replace: missed = false;
caught-by:
    cineris-mcp::it modern::a_change_stream_the_server_ends_is_opened_again_and_the_changes_bumped

[break] a-stream-without-the-notices-asked-for-is-kept
rule: A stream acknowledged without the change notices asked for is ended and not asked for again.
file: crates/cineris-mcp/src/session.rs
in: Router::notified
find: listen.refused = !honoured;
replace: listen.refused = false;
caught-by:
    cineris-mcp::it modern::a_change_stream_acknowledged_without_the_notices_asked_for_is_ended_and_not_asked_again

[break] shutdown-leaves-the-change-stream-open
rule: Shutdown ends the change stream with `notifications/cancelled`, then the process.
file: crates/cineris-mcp/src/session.rs
in: Session::stop
find: self.rpc.transport().cancel(id, "the client is shutting down");
replace: let _ = id;
caught-by:
    cineris-mcp::it modern::shutdown_ends_the_change_stream_and_then_the_process
