# ------------------------------------------------------------ the cache, pruned

[break] pinned-cache-never-pruned
rule: The cache is pruned of the hashes no pin names.
file: crates/cineris-core/src/ext/found.rs
in: keep
find: cache.prune(|hash| pinned.contains(hash))
replace: cache.prune(|_| true)
caught-by:
    extensions_found::pruning_the_cache_keeps_every_trusted_projects_entries

[break] pinned-prune-drops-other-projects
rule: The cache is pruned by every trusted project's pins as well as the user's: a cache that projects share does not drop another project's entries.
file: crates/cineris-core/src/ext/found.rs
in: pinned
find: .pinned_hashes(&kind)
replace: .pinned_hashes(&TrustResourceKind::Hook)
caught-by:
    extensions_found::pruning_the_cache_keeps_every_trusted_projects_entries

[break] pinned-prune-drops-the-users-own
rule: The cache keeps the hashes the user's own pins of extensions name.
file: crates/cineris-core/src/ext/found.rs
in: pinned
