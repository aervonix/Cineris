# The signed approvals step, part: fixes from the full review (stores and
# core) (docs/steps/signed-approvals/parts/full-review-fixes-core.md). Pins
# that do not count are carried forward as held, never signed and never
# dropped by a signed change, and a held entry grants nothing; a project
# left unsigned by a reset is asked about again; nothing another program of
# the user's does on Linux blocks a reset; a folder of the user's takes a
# project's name only by the user's key; the stores write through no link;
# a password is counted with no copy.

# ---------------------------------------- the user's pins: held, never dropped

[break] pins-that-do-not-count-are-dropped
rule: A change proposed over pins that do not count moves them into the held list, never drops them: their gates hold.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::propose
find: file.pins.iter().chain(&file.held).cloned().collect()
replace: Vec::new()
packages: cineris-policy,cineris-core
caught-by:
    cineris-policy trust::pins::tests::a_pin_not_signed_by_the_person_is_never_signed_with_their_next_pin
    cineris-policy trust::pins::tests::a_held_pin_is_approved_again_or_let_go_only_by_the_persons_yes
    cineris-core::it signed::an_unrelated_yes_keeps_the_gate_of_a_pin_it_did_not_show

[break] a-pin-approved-again-stays-held
rule: A pin approved again leaves the held list for the signed set.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::propose
find: held.retain(|old| !old.is_of(&pin.kind, &pin.name));
replace: held.retain(|_| true);
caught-by:
    cineris-policy trust::pins::tests::a_held_pin_is_approved_again_or_let_go_only_by_the_persons_yes

[break] an-unpin-leaves-the-held-pin
rule: A signed unpin of a name takes it out of the held list too: the person's yes naming it is what lets its gates go.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::propose
find: held.retain(|pin| !pin.is_of(kind, name));
replace: held.retain(|_| true);
caught-by:
    cineris-policy trust::pins::tests::a_held_pin_is_approved_again_or_let_go_only_by_the_persons_yes

[break] held-pins-are-not-said
rule: A proposal's summary names each pin it carries as held, for the front end to say.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::propose
find: summary.extend(held.iter().map(|pin| held_line(&pin.kind, &pin.name)));
replace: summary.extend(held.iter().take(0).map(|pin| held_line(&pin.kind, &pin.name)));
packages: cineris-policy,cineris-core
caught-by:
    cineris-policy trust::pins::tests::a_pin_not_signed_by_the_person_is_never_signed_with_their_next_pin
    cineris-core::it signed::an_unrelated_yes_keeps_the_gate_of_a_pin_it_did_not_show

[break] held-pins-hold-no-gate
rule: Beside pins that count, the held list's pins hold their gates, found or gone.
file: crates/cineris-policy/src/trust/pins.rs
in: UserPins::unsigned
find: &self.kept
replace: &[]
packages: cineris-policy,cineris-core
caught-by:
    cineris-policy trust::pins::tests::a_held_pin_is_approved_again_or_let_go_only_by_the_persons_yes
    cineris-core::it signed::an_unrelated_yes_keeps_the_gate_of_a_pin_it_did_not_show
    cineris-core ext::without_engine::tests::a_held_pin_and_a_name_the_users_key_does_not_own_hold_their_gates

[break] a-held-pin-approves
rule: Nothing reads a held pin as a grant: it is no pin to standing, get or list.
file: crates/cineris-policy/src/trust/pins.rs
in: UserPins::get
find: self.list().iter().find(|pin| pin.is_of(kind, name))
replace: self.held().iter().find(|pin| pin.is_of(kind, name))
packages: cineris-policy,cineris-core
caught-by:
    cineris-policy trust::pins::tests::a_held_entry_written_by_another_program_only_holds_a_gate
    cineris-core::it signed::a_held_entry_alone_approves_loads_and_adds_prompt_text_for_nothing

[break] a-name-signed-and-held-is-read
rule: A pin store with a name both signed and held, or held twice, is refused whole.
file: crates/cineris-policy/src/trust/pins.rs
in: PinStore::read
find: let every: Vec<&UserPin> = file.pins.iter().chain(&file.held).collect();
replace: let every: Vec<&UserPin> = file.pins.iter().collect();
caught-by:
    cineris-policy trust::pins::tests::a_held_list_is_read_strictly

