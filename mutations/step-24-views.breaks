[break] config-says-no-origin
rule: /config says where each value came from: its layer, file and line.
file: crates/cortex-tui/src/app/state/commands.rs
in: config_shown
find: let from = origins.get(key).map_or_else(|| "default".to_owned(), origin);
replace: let from = "default".to_owned();
caught-by:
    cortex-tui app::tests::commands::config_says_where_each_value_came_from

[break] the-profile-in-force-is-not-marked
rule: /profile marks the profile in force among those the session's files define.
file: crates/cortex-tui/src/app/state/commands.rs
in: profiles_listed
find: if Some(name.as_str()) == in_force {
replace: if false {
caught-by:
