[break] a-profile-loaded-is-forgotten
rule: The profile /profile loaded is the one in force from then on.
file: crates/cortex-tui/src/app/state.rs
in: reloaded
find: self.profile = Some(profile);
replace: drop(profile);
caught-by:
    cortex-tui app::tests::commands::profile_loads_one_and_lists_them

[break] context-shares-of-the-limit
rule: /context gives each part's share of the whole request.
file: crates/cortex-tui/src/app/state/commands.rs
in: context
find: let whole = parts.estimate.max(1);
replace: let whole = parts.limit.max(1);
caught-by:
    cortex-tui app::tests::commands::context_shows_the_last_request_by_part

[break] verify-is-not-in-this-build
rule: /verify asks the core for the checks, and is not said to be missing.
file: crates/cortex-tui/src/app/state.rs
find: ("verify", "Run the project's checks now")
replace: ("verify-not", "Run the project's checks now")
caught-by:
    cortex-tui app::tests::commands::verify_asks_for_the_checks_and_says_why_none_could_run
    cortex-tui app::tests::help_lists_every_command_and_the_keys

