[break] a-warms-refusal-is-said
rule: A read ahead's refusal is not said: nothing the person asked for depends on it.
file: crates/cortex-tui/src/app/state.rs
find: (Pending::Warm, _) => {}
replace: (Pending::Warm, Ok(_)) => {}
caught-by:
    cortex-tui app::tests::files::a_file_chosen_with_at_is_read_ahead_and_a_refusal_is_not_said

[break] a-chosen-file-is-not-read-ahead
rule: A file chosen from the @ menu is read ahead.
file: crates/cortex-tui/src/input.rs
in: accept
find: Outcome::FileChosen(row.label)
replace: Outcome::Changed
caught-by:
    cortex-tui app::tests::files::a_file_chosen_with_at_is_read_ahead_and_a_refusal_is_not_said
