# The shell environment's fixes (docs/steps/shell-env-fixes/answered.md):
# each path by which the providers' key variables are withheld from a
# command, and the `PATH` a command is given when the harness's own names
# no absolute directory.

# ------------------------------------------- the key variables' two paths

[break] removal-list-not-given-the-key-variables
rule: The core gives the shell's removal list the key variables the session started with, so a variable that stops being a key at a reload is still withheld.
file: crates/cineris-core/src/assemble.rs
find: let mut env_remove = provider::key_variables(settings);
replace: let mut env_remove: Vec<String> = Vec::new();
caught-by:
    cineris-core::it shell::sys_a_reload_withholds_a_new_key_variable_and_still_the_old_one

[break] live-key-variables-not-removed
rule: The shell removes the key variables a reload gave it, beside its configured list.
file: crates/cineris-tools/src/shell/mod.rs
in: ShellTool::removed
find: removed.extend(live.key_variables());
replace:
packages: cineris-tools,cineris-core
caught-by:
    cineris-tools shell::tests::a_reload_reaches_the_next_command
    cineris-core::it shell::sys_a_reload_withholds_a_new_key_variable_and_still_the_old_one

[break] reload-key-variables-not-given-to-the-shell
rule: A reload that changes a provider's key variable gives the shell the new list of key variables.
file: crates/cineris-core/src/reload.rs
find: live.shell_live.set_key_variables(variables);
replace: let _ = variables;
caught-by:
    cineris-core::it shell::sys_a_reload_withholds_a_new_key_variable_and_still_the_old_one

# ------------------------------------------------- a PATH with no absolute

[break] path-left-empty-when-nothing-is-absolute
rule: On Unix a command is never given an empty `PATH`, which is the directory it runs in.
file: crates/cineris-base/src/child_env.rs
in: one_absolute_path
find: Some((name, value)) if windows || !value.is_empty() => env.push((name, value)),
replace: Some((name, value)) => env.push((name, value)),
os: linux
packages: cineris-base,cineris-tools
caught-by:
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories
    cineris-tools::it shell::bash::sys_a_workspace_file_named_like_a_command_does_not_run
    cineris-tools::it shell::sh::sys_a_workspace_file_named_like_a_command_does_not_run
    cineris-base child_env::tests::a_harness_program_searches_only_absolute_directories

[break] path-left-out-when-nothing-is-absolute
rule: On Unix a command is never left without a `PATH`, with which a shell takes a default of its own.
file: crates/cineris-base/src/child_env.rs
in: one_absolute_path
find: _ => env.push((OsString::from(PATH), OsString::from(NO_ABSOLUTE_PATH)))
replace: Some(_) => env.push((OsString::from(PATH), OsString::from(NO_ABSOLUTE_PATH))), None => {}
os: linux
packages: cineris-base,cineris-tools
caught-by:
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories
    cineris-tools::it shell::bash::sys_a_workspace_file_named_like_a_command_does_not_run
    cineris-tools::it shell::sh::sys_a_workspace_file_named_like_a_command_does_not_run
    cineris-base child_env::tests::a_harness_program_searches_only_absolute_directories

[break] path-with-an-absolute-entry-replaced
rule: A `PATH` that keeps an absolute directory is passed on, not replaced.
file: crates/cineris-base/src/child_env.rs
in: one_absolute_path
find: Some((name, value)) if windows || !value.is_empty() => env.push((name, value)),
replace: Some((name, value)) if windows => env.push((name, value)),
os: linux
packages: cineris-base,cineris-tools
caught-by:
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories
    cineris-tools::it shell::bash::sys_a_workspace_file_named_like_a_command_does_not_run
    cineris-base child_env::tests::a_harness_program_searches_only_absolute_directories

# Only the unit test sees this one: the process runner hands the list to
# std's `Command`, which keeps the last value of a name, and `build` puts
# the `PATH` it chose last. The system test's `twice` case is the defect
# the early review found, where the last was the filtered, empty one.
[break] a-second-path-passed-on
rule: An environment that names `PATH` twice gives a command one `PATH`, of absolute directories: a child would take the last, unfiltered.
file: crates/cineris-base/src/child_env.rs
in: one_absolute_path
find: env.retain(|(name, _)| !is_path(name));
replace: if let Some(at) = env.iter().position(|(name, _)| is_path(name)) { env.remove(at); }
packages: cineris-base,cineris-tools
caught-by:
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories
    cineris-base child_env::tests::a_harness_program_searches_only_absolute_directories

[break] a-path-that-holds-a-program
rule: The `PATH` a command is given when none of the harness's is absolute is the system's own directories, and no directory a command could put a program in.
file: crates/cineris-base/src/child_env.rs
in: NO_ABSOLUTE_PATH
in-string: /usr/bin:/bin
replace: /tmp
os: linux
packages: cineris-base,cineris-tools
caught-by:
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories
    cineris-tools::it shell::bash::sys_a_workspace_file_named_like_a_command_does_not_run
    cineris-tools::it shell::sh::sys_a_workspace_file_named_like_a_command_does_not_run
    cineris-base child_env::tests::a_harness_program_searches_only_absolute_directories

[break] path-replaced-without-telling-the-model
rule: The shell tool's description tells the model when a command's `PATH` was replaced, and to run programs by their full paths.
file: crates/cineris-tools/src/shell/mod.rs
find: let path = if path_replaced {
replace: let path = if path_replaced && false {
caught-by:
    cineris-tools shell::tests::the_model_is_told_when_path_is_replaced

[break] the-description-judged-on-the-process-environment
rule: The description judges whether `PATH` is replaced from the environment commands inherit, not the harness's own when another is given.
file: crates/cineris-tools/src/shell/mod.rs
in: described
find: Some(inherited) => inherited,
replace: Some(_) => { own = std::env::vars_os().collect(); &own }
caught-by:
    cineris-tools shell::tests::the_model_is_told_when_path_is_replaced

[break] the-description-not-told-of-the-removal-list
rule: The description is judged from the environment as the removal list leaves it, so a `PATH` the configuration removes is said to be replaced.
file: crates/cineris-tools/src/shell/env.rs
in: path_replaced
find: assemble(inherited.into_iter().cloned(), removed, windows)
replace: assemble(inherited.into_iter().cloned(), &[], windows)
caught-by:
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories

[break] the-description-judged-by-the-paths-text
rule: Whether the description says `PATH` was replaced is told by the code that replaces it, not read back from the text, which a harness's own `PATH` may share.
file: crates/cineris-base/src/child_env.rs
in: one_absolute_path
find: let replaced = !windows && first.as_ref().is_none_or(|(_, value)| value.is_empty());
replace: let replaced = !windows && first.as_ref().is_none_or(|(_, value)| value.is_empty() || value == NO_ABSOLUTE_PATH);
packages: cineris-base,cineris-tools
caught-by:
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories

[break] windows-given-the-unix-path
rule: On Windows the `PATH` is passed on as it is left, and none is made where there was none.
file: crates/cineris-base/src/child_env.rs
in: one_absolute_path
find: _ if windows => {}
replace:
