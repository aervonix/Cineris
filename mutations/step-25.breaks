replace: if false && self.screen.get(index) == Some(row) {
caught-by:
    cortex-term full::tests::the_first_frame_writes_every_row_and_the_next_only_what_changed

[break] full-forgets-a-failed-write
rule: A frame the terminal did not take is drawn whole the next time.
file: crates/cortex-term/src/full.rs
in: Full::draw
find:
    self.scratch = rows;
    self.stale = true;
    return Err(error);
replace:
    self.scratch = rows;
    return Err(error);
caught-by:
    cortex-term full::tests::a_failed_write_is_drawn_whole_next_time

[break] full-shows-a-cursor-below-the-window
rule: A cursor placed below the window is not shown.
file: crates/cortex-term/src/full.rs
in: Full::draw
find: .filter(|cursor| cursor.row < self.rows)
replace: .filter(|cursor| cursor.row <= self.rows)
caught-by:
    cortex-term full::tests::a_row_is_cut_before_the_last_column_and_the_cursor_kept_inside

[break] kept-answer-loses-its-code-colours
