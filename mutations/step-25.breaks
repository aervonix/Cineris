find: again.extend_from_slice(MOUSE_ON);
replace: again.extend_from_slice(b"");
caught-by:
    cortex-term terminal::tests::a_resume_turns_the_mouse_on_again_with_the_alternate_screen

[break] the-older-report-read-with-the-mouse-off
