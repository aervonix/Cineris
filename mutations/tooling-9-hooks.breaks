# The test kit's drive.

[break] a-drive-passes-an-operation-that-never-stopped
rule: Driving an operation to a point fails the test when the operation finishes without stopping there.
file: crates/cortex-testkit/src/hold.rs
in: Hold::drive_within
find: Some(true) => {}
replace: Some(true) | None => {}
caught-by:
    hold::tests::an_operation_that_ends_without_stopping_fails_the_drive_and_says_so

[break] a-drive-never-polls-the-operation
