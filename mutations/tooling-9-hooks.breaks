find: const TEST_ONLY: &[&str] = &["test-hooks", "test-support", "pty"];
replace: const TEST_ONLY: &[&str] = &["test-hooks", "pty"];
packages: xtask
caught-by:
    rules::crate_graph::tests::test_support_is_turned_on_by_dev_dependencies_only
