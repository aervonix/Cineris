# The eleventh tooling step's breaks.

# xtask works on the checkout it runs in, not the one it was built in.

[break] root-is-where-xtask-was-built
rule: Every command works on the checkout the current directory is in, not on the checkout the binary was built from.
file: xtask/src/workspace.rs
in: pick_root
find: None => find_root(here).ok_or_else(
replace: None => find_root(&built_in()).ok_or_else(
caught-by:
    workspace::tests::sys_a_build_from_one_checkout_works_on_the_checkout_it_runs_in

[break] root-is-any-workspace-above
rule: A checkout is a workspace with xtask beside it: another project's workspace inside it (the fuzz targets') is not the root.
file: xtask/src/workspace.rs
in: is_checkout
find: dir.join("xtask").join("Cargo.toml").is_file()
replace: true
caught-by:
    workspace::tests::the_root_is_the_nearest_checkout_at_or_above_the_current_directory

[break] root-option-is-ignored
rule: `--root DIR` names the checkout to work on, wherever xtask runs.
