in: refresh_main
find: let inbox = self.shared.lock();
replace: if let Some(change) = self.shared.lock().next_epoch.take() { self.epoch_waiting = Some(change); } self.take_epoch_models(); let inbox = self.shared.lock();
caught-by:
    cortex-agent::it reconfigure::what_waits_for_the_next_epoch_is_taken_by_a_compaction_and_not_before

[break] the-slot-is-never-taken
