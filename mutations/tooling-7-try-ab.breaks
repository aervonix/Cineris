[break] ab-takes-a-code-for-the-tests-with-no-failed-test
rule: A run whose report names no failed test is not known to have failed by its tests.
file: xtask/src/ab.rs
in: end_of
find: } else if code == Some(TEST_RUN_FAILED) && a_test_failed {
replace: } else if code == Some(TEST_RUN_FAILED) {
caught-by:
    ab::tests::a_run_is_the_tests_failing_only_by_nextests_code_and_a_failed_test_in_its_report

[break] ab-takes-the-wrong-exit-code-for-failing-tests
rule: nextest exits 100 when tests failed in a run.
file: xtask/src/ab.rs
find: pub(crate) const TEST_RUN_FAILED: i32 = 100;
replace: pub(crate) const TEST_RUN_FAILED: i32 = 101;
caught-by:
    ab::tests::a_run_is_the_tests_failing_only_by_nextests_code_and_a_failed_test_in_its_report

# --------------------------------------------- ab: the job's two runs

[break] ab-stops-the-job-at-its-first-failing-run-when-keeping-going
rule: With --keep-going a failure in tiers 1 and 2 does not leave the system tests unmeasured.
file: xtask/src/ab.rs
in: drive_job
find: let stop = failed && !keep_going;
replace: let stop = failed;
caught-by:
    ab::tests::a_failure_in_the_first_run_does_not_stop_the_second_with_keep_going

[break] ab-keeps-going-without-being-asked-in-the-job
rule: Without --keep-going the first failing run ends the job.
file: xtask/src/ab.rs
in: drive_job
find: let stop = failed && !keep_going;
replace: let stop = false;
caught-by:
    ab::tests::without_keep_going_the_first_failing_run_ends_the_job

[break] ab-sets-a-report-aside-when-it-is-the-jobs-last
rule: The job's last run, or the one that ended it, brings the reports together.
file: xtask/src/ab.rs
in: drive_job
find: index + 1 == runs || stop
replace: index + 1 == runs
caught-by:
    ab::tests::without_keep_going_the_first_failing_run_ends_the_job

[break] ab-takes-a-run-that-broke-for-its-tests
rule: A job in which a run broke is not failed by its tests.
file: xtask/src/ab.rs
in: drive_job
find: RunEnd::Broke(said) => { errors.push(said); by_tests = false;
replace: RunEnd::Broke(said) => { errors.push(said);
caught-by:
    ab::tests::a_run_that_broke_or_a_report_that_could_not_be_put_together_is_not_the_tests

[break] ab-takes-reports-that-would-not-come-together-for-the-tests
rule: A job whose reports could not be put together is not failed by its tests.
file: xtask/src/ab.rs
in: drive_job
find: if let Err(error) = after(index, index + 1 == runs || stop) { errors.push(error); by_tests = false;
replace: if let Err(error) = after(index, index + 1 == runs || stop) { errors.push(error);
caught-by:
    ab::tests::a_run_that_broke_or_a_report_that_could_not_be_put_together_is_not_the_tests

[break] ab-takes-the-first-rounds-count-as-a-refusal
rule: A count of rounds that ab refuses is refused by try before the build.
file: xtask/src/try_run.rs
in: validate
find: "ab" => crate::ab::check_arguments(arguments).map_err(refused),
replace: "ab" => Ok(()),
caught-by:
    try_run::tests::what_the_commands_own_parser_would_refuse_is_refused_here

# ----------------------------------------------------- try: a commit

[break] try-takes-a-short-hash-for-a-commit
rule: A commit is the full 40 digits of a hash.
file: xtask/src/try_run.rs
in: commit_hash
find: text.len() == 40
replace: text.len() >= 7
caught-by:
    try_run::tests::a_commit_is_a_full_lower_case_hash_or_nothing

[break] try-takes-upper-case-for-a-commit
rule: A commit is in lower case.
file: xtask/src/try_run.rs
in: commit_hash
find: b'a'..=b'f'
replace: b'a'..=b'f' | b'A'..=b'F'
caught-by:
    try_run::tests::a_commit_is_a_full_lower_case_hash_or_nothing

[break] try-takes-a-name-for-a-commit
rule: A commit is hexadecimal digits and nothing else.
file: xtask/src/try_run.rs
in: commit_hash
find: text.bytes().all(|byte| matches!(byte, b'0'..=b'9' | b'a'..=b'f'))
replace: text.bytes().all(|byte| byte.is_ascii_alphanumeric())
caught-by:
    try_run::tests::a_commit_is_a_full_lower_case_hash_or_nothing

[break] try-runs-in-a-checkout-that-is-not-the-commit
rule: A run asked for one commit never measures another.
file: xtask/src/try_run.rs
in: check_checkout
find: if head.trim() == commit {
replace: if true {
caught-by:
    try_run::tests::the_checkout_must_be_the_commit_asked_for

[break] try-says-nothing-of-the-commit
rule: The plan says which commit the branch's side is.
file: xtask/src/try_run.rs
in: plan
find: if let Some(commit) = &inputs.commit {
replace: if let Some(commit) = inputs.commit.as_ref().filter(|_| false) {
caught-by:
    try_run::tests::a_commit_is_said_in_the_plan

