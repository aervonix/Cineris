find: Err(unused) => unused.held.iter().map(|(name, _)| name.clone()).collect()
replace: Err(_) => Vec::new()
caught-by:
    cineris-core::it signed::a_pinned_users_extension_gone_holds_its_gates_without_the_key

[break] uncounted-pins-give-no-hash
rule: While the user's pins do not count, an extension they pin that does not stand as pinned holds its gates at the hash pinned.
file: crates/cineris-core/src/ext/found/pipeline.rs
