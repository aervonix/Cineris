# Step 21, the editor: its rules broken one at a time, with the tests that
# must fail. Written with the code.

[break] right-splits-a-cluster
rule: Moving right goes over a whole grapheme cluster, never into one.
file: crates/cortex-tui/src/editor/cluster.rs
find: let end = start + offset + cluster.len();
replace: let end = start + offset + cluster.chars().next().map_or(1, char::len_utf8);
caught-by:
    editing::left_and_right_step_one_whole_cluster
    editor::cluster::tests::next_and_prev_step_over_whole_clusters

[break] left-and-backspace-split-a-cluster
rule: Moving left and deleting backwards take a whole grapheme cluster.
file: crates/cortex-tui/src/editor/cluster.rs
in: prev
find: if begin + cluster.len() >= at { return begin; }
replace: if begin + cluster.len() >= at { return at - cluster.chars().last().map_or(1, char::len_utf8); }
caught-by:
    editing::left_and_right_step_one_whole_cluster
    editing::backspace_and_delete_take_one_whole_cluster

[break] a-chip-mark-joins-the-accent-after-it
rule: A chip's mark is a cluster of its own, so an accent typed after it never takes the chip with it.
file: crates/cortex-tui/src/editor/cluster.rs
in: Split::next
find: Some(0) => CHIP.len_utf8(),
replace: Some(0) => self.rest.len(),
caught-by:
    editor::cluster::tests::a_chip_mark_is_a_cluster_of_its_own_even_with_an_accent_after_it
    editing::a_chip_is_one_cluster_sends_its_text_and_expands_in_place_undoably

[break] an-edit-leaves-the-cursor-inside-a-cluster
rule: An edit that joins two clusters leaves the cursor at a cluster boundary.
file: crates/cortex-tui/src/editor/mod.rs
in: Editor::change
find: self.cursor = cluster::snap(self.buffer.text(), at + length);
replace: self.cursor = at + length;
caught-by:
    editing::an_edit_that_joins_two_clusters_leaves_the_cursor_outside_them
    input::a_paste_that_ends_mid_cluster_joins_what_follows

[break] enter-tested-directly
rule: No key is tested for in the interface's code: every key goes through the key map.
file: crates/cortex-tui/src/input.rs
in: Input::key
find: let contexts = self.contexts();
replace:
    if key == Key::plain(cortex_term::KeyCode::Enter) {
        return self.act(Action::Submit);
    }
    let contexts = self.contexts();
caught-by:
    input::a_rebound_key_is_the_only_way_to_its_action
    bindings::every_default_binding_does_its_action

[break] ctrl-j-dropped-from-the-map
rule: Every default binding of 09-tui is in the map: Ctrl+J makes a new line.
file: crates/cortex-tui/src/keys/mod.rs
find: &["shift+enter", "alt+enter", "ctrl+j"]
replace: &["shift+enter", "alt+enter"]
caught-by:
    bindings::the_three_new_line_keys_and_the_redo_keys_are_bound
    decoder::a_new_line_always_has_a_key_plain_input_sends_as_itself

[break] alt-z-dropped-from-the-map
rule: Redo has a key that plain input sends as itself.
file: crates/cortex-tui/src/keys/mod.rs
find: &["ctrl+shift+z", "alt+z"]
replace: &["ctrl+shift+z"]
caught-by:
    bindings::the_three_new_line_keys_and_the_redo_keys_are_bound
    decoder::a_new_line_always_has_a_key_plain_input_sends_as_itself

[break] shifted-letters-not-normalised
rule: Ctrl with an upper-case letter is Shift with the lower-case one, as some terminals report it.
file: crates/cortex-tui/src/keys/mod.rs
in: normalize
find: Key::with(KeyCode::Char(c.to_ascii_lowercase()), key.mods | Mods::SHIFT)
replace: key
caught-by:
    keys::tests::an_upper_case_letter_with_ctrl_is_shift_with_it

[break] a-paste-typed-as-keys
rule: A paste is text, never keys: nothing in it is looked up in the key map.
file: crates/cortex-tui/src/input.rs
in: Input::handle
find: Event::Paste(text) => self.paste(text)
replace:
    Event::Paste(text) => {
        for c in text.chars() {
            let code = if c == '\n' || c == '\r' {
                cortex_term::KeyCode::Enter
            } else {
                cortex_term::KeyCode::Char(c)
            };
            let _ = self.key(Key::plain(code));
        }
        Outcome::Changed
    }
caught-by:
    input::a_paste_is_text_never_keys

[break] twelve-lines-made-a-chip
rule: A paste of more than 12 lines is a chip, and one of 12 is text.
file: crates/cortex-tui/src/paste.rs
in: fragment
find: lines > CHIP_LINES
replace: lines >= CHIP_LINES
caught-by:
    paste::tests::twelve_lines_are_text_and_thirteen_a_chip
    input::a_paste_over_a_limit_is_a_chip_sent_whole_and_one_under_is_text

[break] two-thousand-characters-made-a-chip
rule: A paste of more than 2,000 characters is a chip, and one of 2,000 is text.
file: crates/cortex-tui/src/paste.rs
in: fragment
find: chars > CHIP_CHARS
replace: chars >= CHIP_CHARS
caught-by:
    paste::tests::two_thousand_characters_are_text_and_one_more_a_chip

