[break] an-unclosed-block-is-front-matter
rule: Front matter is closed by a `---` or `...` line; a block never closed is none, and its file is left out.
file: crates/cineris-ext/src/skills.rs
in: FrontMatter::read
find: None
occurrence: 2
replace: Some(Self { fields: fields_of(&body) })
caught-by:
    cineris-ext skills::tests::what_is_and_is_not_front_matter
    cineris-ext skills::tests::a_skill_needs_front_matter_with_a_name_and_its_quirks_are_read

[break] a-later-key-is-kept-too
rule: A key given twice keeps its first value, once.
file: crates/cineris-ext/src/skills.rs
in: fields_of
find: out.iter().any(|(earlier, _)| *earlier == key)
replace: false
caught-by:
    cineris-ext skills::tests::what_is_and_is_not_front_matter

[break] a-block-is-plain-text
rule: A `>` or `|` block is read as its lines, folded or kept.
file: crates/cineris-ext/src/skills.rs
in: scalar
find: Some('|' | '>') if block_header(first) => block(first, more)
replace: Some('|' | '>') if false => block(first, more)
caught-by:
    cineris-ext skills::tests::blocks_keep_or_fold_their_lines
    cineris-ext skills::tests::a_skill_needs_front_matter_with_a_name_and_its_quirks_are_read

[break] quotes-are-kept
rule: A value in quotes is read without them.
file: crates/cineris-ext/src/skills.rs
in: scalar
find: Some(quote @ ('"' | '\'')) => quoted(&first[1..], more, quote)
replace: Some('"' | '\'') => plain(first, more)
caught-by:
    cineris-ext skills::tests::quoted_values_in_both_quotes_and_over_lines
    cineris-ext skills::tests::a_skill_needs_front_matter_with_a_name_and_its_quirks_are_read

[break] escapes-are-not-read
rule: In a `"` string, the escapes are read.
file: crates/cineris-ext/src/skills.rs
in: quoted
find: '\\' if quote == '"' => escape(&mut chars, &mut out)
replace: '\\' if false => escape(&mut chars, &mut out)
caught-by:
    cineris-ext skills::tests::quoted_values_in_both_quotes_and_over_lines
    cineris-ext skills::tests::a_skill_needs_front_matter_with_a_name_and_its_quirks_are_read

[break] a-comment-stays-in-a-plain-value
rule: A comment (` #` and what follows) is not part of a plain value.
file: crates/cineris-ext/src/skills.rs
in: plain
find: without_comment(line.trim_start()).trim_end()
replace: line.trim()
