# Step 28, the fetch client behind extensions' `cineris.http.fetch`
# (crates/cineris-llm/src/fetch.rs): each rule broken one at a time. The
# addresses outside the internet, the IPv6 forms of them, the allowance,
# every address checked, one lookup and a connection to a checked address,
# no proxy, no redirect, the refused headers, the schemes and the limits.

# ------------------------------------------------------------ the addresses

[break] loopback-v4-let-through
rule: An IPv4 loopback address (127.0.0.0/8) is refused unless it is allowed by name.
file: crates/cineris-llm/src/fetch.rs
in: classify_v4
find: (127, _) => Some(AddressKind::Loopback),
replace: (127, _) => None,
caught-by:
    cineris-llm fetch::tests::every_range_outside_the_internet_is_named
    cineris-llm::it fetch::a_name_at_an_address_outside_the_internet_is_refused_with_its_reason
    cineris-llm::it fetch::localhost_reaches_loopback_only_when_it_is_allowed

