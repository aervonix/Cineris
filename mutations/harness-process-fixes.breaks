packages: cineris-base,cineris-core
caught-by:
    cineris-core::it harness_git::sys_a_filter_the_harness_git_runs_is_not_found_in_the_workspace

[break] harness-told-nothing-on-windows
rule: On Windows a program the harness starts for itself is given `NoDefaultCurrentDirectoryInExePath`, as a command is.
file: crates/cineris-base/src/child_env.rs
in: for_harness
find: no_current_directory(&mut env);
replace:
caught-by:
    cineris-base child_env::tests::on_windows_a_harness_program_is_told_not_to_look_where_it_runs

[break] the-known-keys-not-withheld
rule: The keys of the providers the harness knows are withheld whatever list a caller gives.
file: crates/cineris-base/src/child_env.rs
in: is_withheld
find: KNOWN_KEYS
replace: [""; 0]
packages: cineris-base,cineris-tools
caught-by:
    cineris-base child_env::tests::a_harness_program_is_given_no_key_and_the_rest_as_it_came
    cineris-base git::tests::sys_a_filter_driver_is_given_no_key_variable
    cineris-tools shell::env::tests::credentials_are_removed_and_the_rest_is_inherited
    cineris-tools::it shell_search::sys_the_probe_is_given_no_key_variable

# ------------------------------------------------------ the shell's probe

[break] probe-environment-not-cleared
rule: A program run for its answer inherits nothing beside the environment its caller built.
file: crates/cineris-tools/src/process/brief.rs
in: run
find: .env_clear()
replace:
caught-by:
    cineris-tools::it shell_search::sys_the_probe_is_given_no_key_variable

[break] probe-given-the-whole-environment
