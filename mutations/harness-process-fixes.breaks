# The harness's own processes' fixes (docs/steps/harness-process-fixes/answered.md):
# the environment of a program the harness starts for itself (its git, and
# the shell asked its version), and where the shell and git are found.

# ------------------------------------------------------- the harness's git

[break] git-given-the-inherited-environment-as-it-is
rule: The harness's git is given the environment built for it, without the key variables, not the one it inherits.
file: crates/cineris-base/src/git.rs
find: .envs(env)
replace: .envs(confinement.inherited())
packages: cineris-base,cineris-core
caught-by:
    cineris-base git::tests::sys_a_filter_driver_is_given_no_key_variable
    cineris-core::it harness_git::sys_a_reload_withholds_the_keys_from_a_filter_the_harness_git_runs

# The harness's own process holds no key in the tests, so only a variable of
# the test process's own (one nextest sets) shows that git inherited.
[break] git-environment-not-cleared
rule: The harness's git inherits nothing beside the environment built for it.
file: crates/cineris-base/src/git.rs
find: .env_clear()
replace:
caught-by:
    cineris-base git::tests::sys_a_filter_driver_is_given_no_key_variable

[break] git-not-told-the-withheld-list
rule: The harness's git is kept from the key variables its confinement withholds, beside the known ones.
file: crates/cineris-base/src/git.rs
find: &confinement.withheld()
replace: &[]
packages: cineris-base,cineris-core
caught-by:
    cineris-base git::tests::sys_a_filter_driver_is_given_no_key_variable
    cineris-core::it harness_git::sys_a_reload_withholds_the_keys_from_a_filter_the_harness_git_runs

[break] git-keys-not-reloaded
rule: The session's git withholds the key variables a reload sets, through the one value the shell holds too.
file: crates/cineris-core/src/sandbox.rs
in: withheld
find: withheld.extend(self.withheld.get());
replace:
caught-by:
    cineris-core sandbox::tests::the_harness_git_withholds_what_a_reload_sets_and_what_the_start_had
    cineris-core::it harness_git::sys_a_reload_withholds_the_keys_from_a_filter_the_harness_git_runs

[break] git-start-keys-forgotten-at-a-reload
rule: The session's git still withholds a variable that was a key when the session started, after a reload, as the shell's commands do.
file: crates/cineris-core/src/sandbox.rs
in: withheld
find: let mut withheld = self.seeded.clone();
replace: let mut withheld: Vec<String> = Vec::new();
caught-by:
    cineris-core sandbox::tests::the_harness_git_withholds_what_a_reload_sets_and_what_the_start_had
    cineris-core::it harness_git::sys_a_reload_withholds_the_keys_from_a_filter_the_harness_git_runs

[break] git-found-in-the-workspace
rule: The session's git is never one inside the workspace or a write root: the search goes on down `PATH`.
file: crates/cineris-core/src/sandbox.rs
in: git_program
find: cineris_base::program::find_outside(&path, "git", cfg!(windows), &self.avoid)
replace: cineris_base::program::find(&path, "git", cfg!(windows))
caught-by:
    cineris-core sandbox::tests::the_harness_git_is_never_one_inside_the_workspace

[break] workspace-not-avoided-without-a-sandbox
rule: The workspace is avoided for the shell and the harness's git whether commands are confined or not.
file: crates/cineris-core/src/assemble.rs
in: harness_avoid
find: let mut avoid = vec![workspace];
replace: let mut avoid: Vec<PathBuf> = Vec::new(); let _ = workspace;
caught-by:
    cineris-core assemble::tests::the_workspace_is_avoided_with_or_without_a_sandbox

# -------------------------------------------- the PATH every one is given

[break] harness-path-keeps-relative-entries
rule: A program the harness starts searches only the absolute directories of `PATH`: an empty or relative entry names the workspace.
file: crates/cineris-base/src/child_env.rs
in: absolute_entries
find: absolute(entry)
replace: true
os: linux
packages: cineris-base,cineris-tools
caught-by:
    cineris-base child_env::tests::a_harness_program_searches_only_absolute_directories
    cineris-base git::tests::sys_a_relative_path_entry_does_not_find_a_filter
    cineris-tools shell::env::tests::path_keeps_only_its_absolute_directories

[break] git-searches-the-workspace
rule: A program the harness starts for itself does not search a directory of `PATH` inside the workspace or a write root.
file: crates/cineris-base/src/child_env.rs
in: for_harness
find: keep_out_of(&mut env, avoid, windows);
replace:
caught-by:
    cineris-base child_env::tests::a_harness_program_does_not_search_the_workspace

[break] git-not-told-what-to-avoid
rule: The harness's git is given a `PATH` without the directories its confinement avoids.
