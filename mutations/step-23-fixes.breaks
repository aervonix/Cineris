replace: if self.terminal.is_some() {
caught-by:
    cortex-tui::it external::sys_a_signal_while_the_editor_runs_leaves_the_terminal_to_the_shell

# The dialogs' key rule (finding 1 of the review, the owner's rule), the
# note cut off (finding 8), and the dialogs' rules the review found untested.

[break] typing-through-a-dialog-answers-it
