# Small fixes II: a terminal's reply typed into the input box, and a key the
# terminal held judged by when it was pressed. Written with the code.
#
# The hold's other rules keep their breaks in `ci-budgets.breaks`, re-aimed
# at the code as it is now: that the hold exists at all
# (`escape-wait-ignores-the-replies`), that the last reply ends it
# (`escape-wait-outlives-the-last-reply`), that it ends 3 s after the
# queries (`escape-wait-without-an-end`), and its floor
# (`escape-wait-counted-from-the-queries`).

# ------------------------------------------------ the hold of a lone ESC

[break] a-reply-escape-is-held-only-its-own-time
rule: While the replies to the queries are due, a lone ESC is held until they end or 3 s after the queries, not for a time of its own.
file: crates/cineris-term/src/terminal.rs
in: Terminal::escape_deadline
find: (self.queried + REPLIES_DUE).max(since + REPLY_ESCAPE_WAIT)
replace: since + REPLY_ESCAPE_WAIT
packages: cineris-term,cineris-tui
caught-by:
    cineris-term terminal::tests::a_reply_whose_escape_comes_a_second_before_its_rest_types_nothing
    cineris-term terminal::tests::with_no_last_reply_the_longer_wait_ends_when_the_replies_are_no_longer_due
    cineris-tui app::tests::first_run::a_reply_split_after_its_escape_never_goes_into_the_key
    cineris-tui secret::tests::auth_login_is_neither_cancelled_nor_typed_into_by_a_split_reply

[break] a-held-escape-is-not-released-by-the-key-after-it
rule: A byte that comes a while after the last byte kept behind a held ESC, and cannot go on from it, ends the ESC's claim: the ESC is the Escape key at once, before what came.
file: crates/cineris-term/src/terminal.rs
in: Terminal::next
find: Some(false) => self.decoder.release_escape(&mut found),
replace: Some(false) => {},
caught-by:
    terminal::tests::keys_typed_while_the_replies_are_due_come_in_order
    terminal::tests::keys_typed_a_while_apart_while_the_replies_are_due_are_those_keys
    terminal::tests::a_reply_that_lost_its_escape_while_the_replies_are_due_types_nothing
    terminal::tests::only_input_behind_a_key_counts_as_queued

[break] a-held-escape-is-released-within-its-own-wait
rule: Within `ESCAPE_WAIT` of the last byte kept, what follows a held ESC is read with it, as always (`ESC x` is `Alt+x`).
file: crates/cineris-term/src/terminal.rs
in: Terminal::next
find: .is_some_and(|at| now.saturating_duration_since(at) >= ESCAPE_WAIT)
replace: .is_some_and(|at| now >= at)
caught-by:
    terminal::tests::an_escape_that_waited_alone_is_the_escape_key_at_the_holds_end

[break] a-split-sequence-is-cut-at-its-escape
rule: A lone held ESC followed a while later by what may begin a sequence (a focus report, a key's, a paste's mark, a reply) is not released: the sequence is read whole.
file: crates/cineris-term/src/input.rs
in: Decoder::kept_escape_goes_on
find: None | Some(b'[' | b']' | b'O' | b'P' | b'_' | b'^' | b'X')
replace: None
caught-by:
    terminal::tests::a_sequence_split_after_its_escape_while_the_replies_are_due_is_the_sequence
    terminal::tests::a_reply_that_comes_a_key_at_a_time_is_the_reply
    input::tests::what_goes_on_from_a_kept_escape_after_a_while

[break] an-escape-before-a-reply-is-swallowed
rule: A second ESC a while after a held lone ESC is a fresh one: the first is the Escape key, and a reply or a key's sequence after the second never swallows it.
file: crates/cineris-term/src/input.rs
in: Decoder::kept_escape_goes_on
find: None | Some(b'[' | b']' | b'O' | b'P' | b'_' | b'^' | b'X')
replace: None | Some(b'[' | b']' | b'O' | b'P' | b'_' | b'^' | b'X' | 0x1b)
caught-by:
    terminal::tests::keys_typed_while_the_replies_are_due_come_in_order
    terminal::tests::keys_typed_a_while_apart_while_the_replies_are_due_are_those_keys
    terminal::tests::only_input_behind_a_key_counts_as_queued
    input::tests::what_goes_on_from_a_kept_escape_after_a_while

[break] a-key-a-while-after-a-held-sequence-joins-it
rule: After more than a held ESC, only the rest of a reply goes on from it a while later: a person's key is that key, and the ESC and what was kept after it are keys too.
file: crates/cineris-term/src/input.rs
in: Decoder::kept_escape_goes_on
find: Some(reply_shape(&after) != ReplyShape::Not)
replace: Some(true)
caught-by:
    terminal::tests::keys_typed_a_while_apart_while_the_replies_are_due_are_those_keys
    input::tests::what_goes_on_from_a_kept_escape_after_a_while

[break] a-reply-that-comes-a-key-at-a-time-is-cut
rule: The rest of a reply goes on from its held ESC however late each key of it comes, while the replies are due.
file: crates/cineris-term/src/input.rs
in: Decoder::kept_escape_goes_on
find: Some(reply_shape(&after) != ReplyShape::Not)
replace: Some(false)
caught-by:
    terminal::tests::a_reply_that_comes_a_key_at_a_time_is_the_reply
    input::tests::what_goes_on_from_a_kept_escape_after_a_while

[break] an-escape-that-waited-alone-becomes-alt
rule: A held ESC that a byte came a while after, whose sequence never ended, is the Escape key at the hold's end, and what came after it is decoded on its own.
file: crates/cineris-term/src/terminal.rs
in: Terminal::next
find: Some(true) => self.split = true,
replace: Some(true) => {},
caught-by:
    terminal::tests::an_escape_that_waited_alone_is_the_escape_key_at_the_holds_end

[break] a-released-escape-is-dropped
rule: The ESC released from a hold is given as the Escape key, never dropped.
file: crates/cineris-term/src/input.rs
in: Decoder::release_escape
find: events.push(key(KeyCode::Esc));
replace:
caught-by:
    input::tests::what_goes_on_from_a_kept_escape_after_a_while
    terminal::tests::keys_typed_while_the_replies_are_due_come_in_order

# ------------------------------------------- a reply that lost its ESC

[break] a-reply-without-its-escape-is-typed
rule: While the replies are due, a reply whose ESC was taken on its own is read as the reply, never typed.
file: crates/cineris-term/src/input.rs
in: Decoder::decode
find: if self.replies && matches!(self.buffer[start], b'[' | b']')
replace: if false && matches!(self.buffer[start], b'[' | b']')
caught-by:
    input::tests::a_reply_without_its_escape_is_the_reply_only_while_they_are_due
    terminal::tests::a_reply_that_lost_its_escape_while_the_replies_are_due_types_nothing

[break] the-device-attributes-without-an-escape-are-typed
rule: The device attributes' reply (`CSI ? … c`) is one of the replies read without its ESC.
file: crates/cineris-term/src/input.rs
in: reply_shape
find: b'u' | b'c' if !dollar => return ReplyShape::Whole(at + 1),
replace: b'u' if !dollar => return ReplyShape::Whole(at + 1),
caught-by:
    input::tests::the_shapes_of_the_replies_to_the_queries
    input::tests::a_reply_without_its_escape_is_the_reply_only_while_they_are_due

[break] a-bracket-not-followed-by-a-question-mark-begins-a-reply
rule: Only `[ ?` begins a reply of the shape `CSI ? …`: a `[` followed by anything else is a key at once.
file: crates/cineris-term/src/input.rs
in: reply_shape
find: Some(_) => return ReplyShape::Not
replace: Some(_) => {}
caught-by:
    input::tests::the_shapes_of_the_replies_to_the_queries

[break] a-held-bracket-is-never-given
rule: A `[` held as the start of a reply is a key once the replies are no longer due.
file: crates/cineris-term/src/input.rs
in: Decoder::decode
find: ReplyShape::Part if !flushing => break,
replace: ReplyShape::Part if flushing || !flushing => break,
caught-by:
    terminal::tests::keys_typed_while_the_replies_are_due_come_in_order

[break] a-reply-begun-while-due-is-typed-after
rule: A reply whose start was held while the replies were due is still read as the reply when its rest comes after they stopped being due.
file: crates/cineris-term/src/terminal.rs
in: Terminal::next
find: || self.pending_since.is_some_and(|since| self.held_for_replies(since))
replace: || false
caught-by:
    terminal::tests::a_reply_begun_while_the_replies_were_due_ends_as_a_reply_after

# ------------------------------------------- when an event's first byte came

[break] an-event-is-stamped-when-it-was-read
rule: An event read is given with when its first byte came: a released ESC's when the ESC came, a paste's its first read.
file: crates/cineris-term/src/terminal.rs
in: Terminal::next
find: Ready::Input => began.unwrap_or(now),
replace: Ready::Input => now,
caught-by:
    terminal::tests::each_event_says_when_its_first_byte_came

[break] a-flushed-escape-is-stamped-at-its-flush
rule: An ESC given at the hold's end came when it came, not when the hold ended.
file: crates/cineris-term/src/terminal.rs
in: Terminal::next
find: self.pending_since.take()
replace: self.pending_since.take().map(|_| self.device.now())
caught-by:
    terminal::tests::each_event_says_when_its_first_byte_came

[break] a-reply-behind-a-key-makes-it-typing
rule: Only a key or a paste behind a key makes it one of keys read together; a reply, a focus report or a resize does not.
file: crates/cineris-term/src/terminal.rs
in: Terminal::queued
find: matches!(event, Event::Key(_) | Event::Repeat(_) | Event::Paste(_))
replace: !matches!(event, Event::Resumed)
caught-by:
    terminal::tests::only_input_behind_a_key_counts_as_queued

[break] the-loop-judges-a-key-when-it-was-read
rule: The loop hands the application when a key's first byte came, by which a dialog judges whether it was ready for it.
file: crates/cineris-tui/src/app.rs
in: take
find: app.terminal_pressed(event, terminal.came(), terminal.now())
replace: app.terminal_pressed(event, terminal.now(), terminal.now())
caught-by:
    app::tests::an_escape_the_terminal_held_does_not_answer_a_dialog_it_was_pressed_before

[break] a-held-key-is-judged-when-it-was-read
rule: Whether a dialog was ready for a key is judged when the key was pressed: a held Escape pressed before it was ready does not answer it.
file: crates/cineris-tui/src/app/state.rs
in: App::judged
find: self.pressed.map_or(at, |pressed| pressed.min(at))
replace: at
caught-by:
    app::tests::dialogs::a_held_escape_pressed_before_the_dialog_was_ready_does_not_answer_it
    app::tests::an_escape_the_terminal_held_does_not_answer_a_dialog_it_was_pressed_before

[break] a-first-run-step-judges-a-key-when-it-was-read
rule: A step of the first run judges a key by when it was pressed: one the terminal held, pressed in its grace and read after, does not answer it.
file: crates/cineris-tui/src/app/state/first_run.rs
in: App::first_run_event
find: if !run.takes_keys(pressed) {
replace: if !run.takes_keys(at) {
caught-by:
    app::tests::first_run::an_escape_pressed_in_the_key_steps_grace_and_read_later_does_not_go_back

[break] a-panel-judges-a-key-when-it-was-read
rule: A panel judges a key by when it was pressed: one the terminal held, pressed in its grace and read after, does not act.
file: crates/cineris-tui/src/app/state/panel.rs
in: App::panel_key
find: self.panels.ready(id, self.judged(at))
replace: self.panels.ready(id, at)
caught-by:
    app::tests::panels::a_key_pressed_in_the_panels_grace_and_read_after_it_does_not_act

[break] the-rewind-question-judges-a-paste-when-it-was-read
rule: The rewind's question judges a paste by when it began: one begun before it was ready and read after reaches nothing.
file: crates/cineris-tui/src/app/state.rs
in: App::terminal
find: .is_some_and(|dialog| dialog.swallows(self.judged(at)))
replace: .is_some_and(|dialog| dialog.swallows(at))
caught-by:
    app::tests::rewind::a_paste_begun_before_the_question_was_ready_and_read_after_reaches_nothing

[break] the-full-screen-dialog-judges-tab-when-it-was-read
rule: In the full screen a dialog judges `Tab` by when it was pressed: one pressed in its grace and read after does not start reading the transcript.
file: crates/cineris-tui/src/app/state.rs
in: App::terminal
find: let ready = dialog.takes_keys(self.judged(at));
replace: let ready = dialog.takes_keys(at);
caught-by:
    app::tests::screen::a_tab_pressed_in_the_grace_and_read_after_it_does_not_start_reading

[break] a-held-key-counts-as-input-when-it-was-pressed
rule: A held key or a split paste is input from when it was read, the later time: a key just after it waits the quiet second.
file: crates/cineris-tui/src/app/state.rs
in: App::terminal_pressed
find: let input = self.terminal(event, at);
replace: let input = self.terminal(event, pressed);
caught-by:
    app::tests::dialogs::a_key_just_after_a_held_escape_is_read_does_not_answer
    app::tests::dialogs::a_paste_split_across_reads_holds_the_dialog_from_its_end
    app::tests::dialogs::a_held_escape_that_answers_holds_the_next_dialog_from_when_it_was_read

# ------------------------------------------- the protected look's hash arm
#
# Found while settling `step-26/protected-change-not-detected`, whose named
# test reached the hash arm and never the stamp: the hash arm had no break.

[break] protected-hash-change-not-detected
rule: A protected file too large to keep and hashed by both looks is modified when its hash changed, whatever its size and times say.
file: crates/cineris-sandbox/src/protect.rs
in: Entry::change_from
find: (self.hash != old.hash).then(|| old.before())
replace: None
caught-by:
    cineris-sandbox protect::tests::a_change_that_puts_the_modification_time_back_is_still_found

# ------------------------------------- statistics off prune nothing
#
# Found while settling `step-16/showing-the-statistics-prunes`: the usage
# report's own guard had no break and no test.

[break] a-report-with-statistics-off-prunes
rule: With statistics off a usage report changes nothing on the disk: nothing is written, so no month is pruned, whatever the retention.
file: crates/cineris-core/src/usage.rs
in: report
find: recording.then_some(retention)
replace: Some(retention)
caught-by:
    cineris-core::it usage::a_report_with_statistics_off_prunes_nothing
