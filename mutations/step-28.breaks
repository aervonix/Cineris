[break] a-torn-down-runtime-says-so-late
rule: A runtime torn down by a limit says so before the call's end is told.
file: crates/cineris-ext/src/engine/thread.rs
in: run
find:
        if let After::TornDown = after {
            self.alive.store(false, Ordering::SeqCst);
