# Step 28: extensions. The rules of `cineris-ext` and of the core's side of
# its host functions, broken one at a time, with the tests that must fail.
# Written with the code (docs/steps/28/answered.md).

[break] a-host-read-skips-the-manifest
rule: A host read is checked against the manifest's `read` globs before the host is asked.
file: crates/cineris-ext/src/host.rs
in: serve
find:
            let resolved = host.resolve(&path).await?;
            capabilities.read(&resolved)?;
            let text = host.read(resolved, offset, limit).await?;
replace:
            let resolved = host.resolve(&path).await?;
            let text = host.read(resolved, offset, limit).await?;
caught-by:
    cineris-ext::it capability::a_read_is_judged_where_its_path_leads_however_it_is_written

[break] a-host-write-skips-the-manifest
rule: A host write is checked against the manifest's `write` globs before the host is asked.
file: crates/cineris-ext/src/host.rs
in: serve
find: capabilities.write(&resolved)?;
replace: let _ = &resolved;
caught-by:
    cineris-ext::it capability::a_write_is_judged_the_same_way

[break] an-unlisted-program-reaches-the-host
rule: A program runs only when the manifest lists it exactly as the script names it.
file: crates/cineris-ext/src/host.rs
in: serve
find: let program = capabilities.exec(&program)?.clone();
replace: let program = crate::manifest::Program::Name(program);
caught-by:
    cineris-ext::it engine::a_program_the_manifest_does_not_list_never_reaches_the_host
    cineris-ext::it serve::the_manifest_is_asked_before_the_host

[break] a-walks-entries-are-not-checked
rule: Each entry a listing or a search reaches is checked against the manifest on its own.
file: crates/cineris-ext/src/host.rs
find: self.inner.may_read(path) && self.manifest.allows(path)
replace: self.inner.may_read(path)
caught-by:
    cineris-ext::it capability::each_entry_a_walk_reaches_is_checked_on_its_own

