in: FollowingTheProgram::start
find: sandbox.start_git_confined(git, arguments)
replace: Ok(sandbox.start_git(git, arguments))
caught-by:
    cineris-core::it ext_exec::confined::sys_the_look_after_a_program_runs_git_confined_at_unrestricted

