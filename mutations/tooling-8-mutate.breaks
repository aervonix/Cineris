in: parse
find: if let Some((find_line, _)) = draft.take("find") {
replace: if let Some((find_line, _)) = None::<(usize, ())> {
caught-by:
    mutate::list::tests::an_in_string_stands_for_a_find_and_the_two_do_not_go_together

[break] in-string-is-not-in-what-a-result-is-kept-for
rule: A break's `in-string` is part of what its result is kept for: an `in-string` and a `find` of one text are two breaks.
file: xtask/src/mutate/list.rs
in: definition
find: if self.in_string {
replace: if false {
caught-by:
    mutate::list::tests::an_in_string_stands_for_a_find_and_the_two_do_not_go_together

[break] in-string-option-is-read-as-a-find
rule: `--in-string` of a one-off break is the text to change inside a string, not a `find`.
file: xtask/src/mutate/mod.rs
in: parse
find: "--in-string" => one.in_string = Some(value),
replace: "--in-string" => one.find = Some(value),
caught-by:
    mutate::tests::a_break_given_with_an_in_string_is_checked_like_one_of_a_list

[break] in-string-one-off-is-a-find
rule: A one-off break given with `--in-string` is an in-string break.
file: xtask/src/mutate/list.rs
in: to_break
find: in_string: self.in_string.is_some()
replace: in_string: false
caught-by:
    mutate::tests::a_break_given_with_an_in_string_is_checked_like_one_of_a_list

[break] in-string-is-not-found-again-by-fix-in
rule: `--fix-in` looks for an `in-string` text in the literals of the file, not for code.
file: xtask/src/mutate/list.rs
in: find_everywhere
find: lex::strings_everywhere(source, tokens, &self.find)
replace: lex::find_everywhere(source, tokens, &self.find)
caught-by:
    mutate::fix::tests::a_text_in_a_string_moved_into_another_item_is_found_by_its_text

# --------------------------------------------------------------- the jobs

[break] jobs-take-a-piece-without-the-lock
rule: A job takes its next piece under the lock the run's thread asks the time under, so no job takes one after the answer "up" is written down.
file: xtask/src/mutate/jobs.rs
in: for_each
find: let _claiming = claim.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
replace: let _claiming = ();
caught-by:
    mutate::jobs::tests::no_job_starts_a_piece_once_the_time_is_up

[break] jobs-ask-the-time-without-the-lock
rule: The run's thread asks the time and writes the answer down under the lock a job takes a piece under.
file: xtask/src/mutate/jobs.rs
in: for_each
find: let _asking = claim.lock().unwrap_or_else(|poisoned| poisoned.into_inner());
replace: let _asking = ();
caught-by:
    mutate::jobs::tests::no_job_starts_a_piece_once_the_time_is_up

