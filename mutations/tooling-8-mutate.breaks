[break] changed-ignores-the-build-settings
rule: A change to the workspace's manifest, lock file or nextest configuration chooses every break.
file: xtask/src/mutate/changed.rs
in: select
find: let settings = SETTINGS.iter().find(|file| touched.contains(**file));
