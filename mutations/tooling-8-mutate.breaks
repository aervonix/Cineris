find: .map_or(entry, |(_, name)| name.trim());
replace: .map_or(entry, |(_, _)| entry);
caught-by:
    mutate::changed::tests::a_name_that_ends_in_a_star_is_a_beginning

[break] changed-reads-a-star-as-the-whole-word
