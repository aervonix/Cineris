in: command_folder
find: hash.add(scratch.as_os_str().as_encoded_bytes());
replace:
caught-by:
    mutate::drive::tests::no_two_jobs_give_their_tests_one_scratch_base

[break] tests-not-given-their-scratch-base
rule: Cargo is started with the job's own scratch base as its tests' CINERIS_TEST_TMPDIR.
file: xtask/src/mutate/drive.rs
in: CargoRunner::command
find: .env(TESTS_BASE, &self.tests.dir)
replace:
caught-by:
    mutate::drive::tests::each_jobs_cargo_is_given_the_jobs_own_scratch_base_for_its_tests

[break] a-folder-left-there-is-trusted
rule: A job's tests' scratch base is emptied before each run: what a killed or kept run left there is not trusted.
file: xtask/src/mutate/drive.rs
in: TestsBase::make
find: let note = crate::combine::remove_tree(&self.dir).err();
replace: let note: Option<String> = None;
caught-by:
    mutate::drive::tests::the_tests_scratch_base_is_made_empty_before_a_run_and_removed_after_it

[break] tests-scratch-base-left-behind
rule: A job's tests' scratch base is removed after a run, with what a failed test left in it.
file: xtask/src/mutate/drive.rs
in: TestsBase::remove
find: let failed = crate::combine::remove_tree(&self.dir).err();
replace: let failed: Option<String> = None;
caught-by:
    mutate::drive::tests::the_tests_scratch_base_is_made_empty_before_a_run_and_removed_after_it
