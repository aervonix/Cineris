[break] a-folder-not-removed-is-not-logged
rule: A scratch base that could not be emptied or removed is said in the job's log.
file: xtask/src/mutate/drive.rs
in: CargoRunner::after_run
find: let _ = writeln!(log, "xtask mutate: {note}");
